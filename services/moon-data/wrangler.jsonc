{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ar-moon-data",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://ark0ishi.github.io"
  },
  "kv_namespaces": [
    {
      "binding": "MOON_DATA",
      "id": "204a375d9475449cb4ae10d01a654a9b"
    }
  ]
}
