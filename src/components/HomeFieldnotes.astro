---
import { lightNotePhotos } from '../data/lightNotes';
import KaleidoscopeLink from './KaleidoscopeLink.astro';

const selections = [
  { id: '20260716-191447', title: '重返西湖', story: 'westlake-return', caption: '晚霞落进湖面，两周后的西湖换了一种光。' },
  { id: '20260705-224241', title: '夜航', story: 'night-flight', caption: '从舷窗回望，街道与灯火铺成一张发亮的电路。' },
  { id: '20260713-101553', title: '雨中的南大', story: 'nju-gulou', caption: '草坪、雨伞与北大楼，在雨里显出更深的绿。' },
].map(selection => {
  const photo = lightNotePhotos.find(photo => photo.id === selection.id);
  if (!photo) throw new Error(`Missing homepage photograph: ${selection.id}`);
  return { ...selection, photo };
});
---

<section class="home-fieldnotes" aria-labelledby="home-fieldnotes-title">
  <div class="fieldnotes-inner">
    <header class="fieldnotes-heading">
      <div>
        <p class="fieldnotes-kicker">LIGHT NOTES / 行旅影像</p>
        <h2 id="home-fieldnotes-title">七月，留下这些<em>光。</em></h2>
      </div>
      <div class="fieldnotes-intro">
        <span class="fieldnotes-count">2026.07 / {lightNotePhotos.length} FRAMES</span>
        <p>湖岸、夜航与雨中的校园。让一只同行的小偶，把不同城市的日子连成一页。</p>
      </div>
    </header>

    <div class="fieldnotes-grid">
      {selections.map((selection, index) => (
        <figure class={`fieldnote fieldnote-${index + 1}`}>
          <a class="fieldnote-image" href={`/light-notes/#${selection.story}`} aria-label={`翻阅${selection.title}：${selection.photo.location.city}，${selection.photo.location.place}`}>
            <img
              src={selection.photo.thumb}
              srcset={`${selection.photo.thumb} 720w, ${selection.photo.full} 2000w`}
              sizes={index === 0 ? '(max-width: 760px) calc(100vw - 48px), (max-width: 1228px) 43vw, 520px' : '(max-width: 760px) calc(100vw - 48px), (max-width: 1228px) 25vw, 300px'}
              alt={selection.photo.alt}
              width={selection.photo.thumbWidth}
              height={selection.photo.thumbHeight}
              loading="lazy"
              decoding="async"
            />
          </a>
          <figcaption>
            <div class="fieldnote-meta"><time datetime={selection.photo.shotAt}>{selection.photo.shotAt.slice(5, 10).replace('-', ' / ')}</time><span>{selection.photo.location.city}</span></div>
            <h3><a href={`/light-notes/#${selection.story}`}>{selection.title}<span aria-hidden="true">↗</span></a></h3>
            <p>{selection.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>

    <KaleidoscopeLink />

    <footer class="fieldnotes-footer"><span>先把时间与地点存下，再慢慢写成故事。</span><a href="/light-notes/">展开 {lightNotePhotos.length} 张光影札记 <span aria-hidden="true">→</span></a></footer>
  </div>
</section>

<style>
  .home-fieldnotes { margin: clamp(70px, 9vw, 128px) 0; padding: clamp(46px, 6.5vw, 82px) 0; background: var(--paper-deep); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .fieldnotes-inner { width: var(--page); margin: 0 auto; }
  .fieldnotes-heading { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: end; margin-bottom: 42px; }
  .fieldnotes-kicker { margin: 0 0 18px; color: var(--red); font: 400 10px/1.6 var(--mono); letter-spacing: .12em; }
  .fieldnotes-heading h2 { margin: 0; font: 500 clamp(29px, 3.8vw, 48px)/1.45 var(--serif); letter-spacing: -.025em; }
  .fieldnotes-heading h2 em { font-style: normal; color: var(--red); }
  .fieldnotes-intro { max-width: 355px; justify-self: end; }
  .fieldnotes-count { color: var(--ink-soft); font: 400 10px/1.6 var(--mono); letter-spacing: .12em; }
  .fieldnotes-intro p { margin: 12px 0 0; color: var(--ink-soft); font-size: 13px; line-height: 2; }
  .fieldnotes-grid { display: grid; grid-template-columns: 1.48fr .86fr .86fr; gap: clamp(18px, 2.8vw, 36px); align-items: start; }
  .fieldnote { min-width: 0; margin: 0; }
  .fieldnote-2 { padding-top: 56px; }
  .fieldnote-3 { padding-top: 104px; }
  .fieldnote-image { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--wash); }
  .fieldnote-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s ease; }
  .fieldnote-image:hover img { transform: scale(1.025); }
  .fieldnote-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--line); color: var(--ink-soft); font: 400 10px/1.6 var(--mono); letter-spacing: .08em; }
  .fieldnote h3 { margin: 14px 0 6px; font: 500 clamp(21px, 2.2vw, 29px)/1.5 var(--serif); }
  .fieldnote h3 a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; }
  .fieldnote h3 span { color: var(--red); font: 400 15px/1 var(--mono); }
  .fieldnote figcaption > p { margin: 0; color: var(--ink-soft); font-size: 12px; line-height: 2; }
  .fieldnotes-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px 24px; margin-top: 38px; padding-top: 23px; border-top: 1px solid var(--line); font-size: 12px; }
  .fieldnotes-footer > span { color: var(--ink-soft); }
  .fieldnotes-footer a { min-height: 44px; display: inline-flex; align-items: center; gap: 24px; }
  .fieldnotes-footer a span { color: var(--red); }
  a:focus-visible { outline: 2px solid var(--red); outline-offset: 5px; }
  @media (max-width: 760px) {
    .fieldnotes-heading { grid-template-columns: 1fr; gap: 20px; margin-bottom: 30px; }
    .fieldnotes-intro { justify-self: start; max-width: 34em; }
    .fieldnotes-grid { grid-template-columns: 1fr; gap: 36px; }
    .fieldnote-2, .fieldnote-3 { padding-top: 0; }
    .fieldnote-meta { margin-top: 14px; }
    .fieldnote h3 { margin-top: 9px; font-size: 25px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fieldnote-image img { transition: none; }
    .fieldnote-image:hover img { transform: none; }
  }
</style>
