---
import { fallbackTrack, neteaseMusic } from '../data/music';

const firstTrack = neteaseMusic.tracks[0];
const initialTrackCount = neteaseMusic.tracks.length;
const initialTrackCounter = `01 / ${String(initialTrackCount).padStart(2, '0')}`;
const serializedConfig = JSON.stringify({
  manifest: neteaseMusic.manifest,
  tracks: neteaseMusic.tracks,
  fallback: fallbackTrack,
}).replaceAll('<', '\\u003c');
---

<aside
  class="music-dock"
  data-music-dock
  transition:persist="night-signal"
  aria-label="夜间网易云音乐播放器"
>
  <audio data-music-audio preload="metadata"></audio>

  <div class="music-compact" data-music-compact>
    <button
      class="music-open"
      type="button"
      data-music-toggle
      aria-expanded="false"
      aria-controls="night-signal-panel"
    >
      <span class="signal-orbit" aria-hidden="true"><i></i><i></i></span>
      <span class="music-open-copy">
        <small>NETEASE SIGNAL</small>
        <strong data-compact-title>{firstTrack?.title || '夜间信号'}</strong>
        <span data-compact-lyric>歌词链路准备中</span>
      </span>
    </button>
    <button class="music-quick-play" type="button" data-music-play aria-label={`播放 ${firstTrack?.title || '当前曲目'}`}>
      <span class="play-shape" aria-hidden="true"></span>
      <span class="pause-shape" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <section class="music-panel" id="night-signal-panel" data-music-panel hidden>
    <header class="music-panel-header">
      <div>
        <p class="music-kicker"><span></span>NETEASE SIGNAL · 31°N</p>
        <p class="music-state" data-music-state>正在读取同源歌单与歌词</p>
      </div>
      <button class="music-collapse" type="button" data-music-toggle aria-label="收起音乐播放器">
        <span aria-hidden="true"></span>
      </button>
    </header>

    <div class="music-track">
      <div class="music-disc" data-music-disc aria-hidden="true">
        <img data-music-cover alt="" hidden />
        <span></span><i></i>
      </div>
      <div class="music-track-copy">
        <p class="music-track-title" data-music-title>{firstTrack?.title || '等待曲目'}</p>
        <p class="music-track-artist" data-music-artist>{firstTrack?.artist || '网易云音乐'}</p>
        <p class="music-track-note" data-music-note>{firstTrack?.note || '等待夜间信号接入。'}</p>
      </div>
    </div>

    <div class="music-lyric-strip" data-music-lyric-strip>
      <small data-music-lyric-label>CURRENT LYRIC / 当前歌词</small>
      <p data-music-lyric>正在同步歌词……</p>
      <span data-music-next-lyric></span>
    </div>

    <div class="music-timeline">
      <label class="sr-only" for="night-signal-progress">播放进度</label>
      <input
        id="night-signal-progress"
        data-music-progress
        type="range"
        min="0"
        max="1000"
        value="0"
        step="1"
        aria-valuetext="0 分 00 秒"
      />
      <div class="music-time" aria-hidden="true">
        <span data-music-current>0:00</span>
        <span data-music-duration>–:––</span>
      </div>
    </div>

    <div class="music-controls">
      <button class="music-mode" type="button" data-music-mode aria-label="当前为列表循环，点击切换播放模式">
        <span data-music-mode-icon aria-hidden="true">↻</span><small data-music-mode-label>列表循环</small>
      </button>
      <div class="music-transport">
        <button type="button" data-music-prev aria-label="上一首"><span aria-hidden="true">│◀</span></button>
        <button class="music-main-play" type="button" data-music-play aria-label={`播放 ${firstTrack?.title || '当前曲目'}`}>
          <span class="play-shape" aria-hidden="true"></span>
          <span class="pause-shape" aria-hidden="true"><i></i><i></i></span>
        </button>
        <button type="button" data-music-next aria-label="下一首"><span aria-hidden="true">▶│</span></button>
      </div>
      <div class="music-volume">
        <button type="button" data-music-mute aria-label="静音" aria-pressed="false">
          <span class="volume-on" aria-hidden="true">◖</span>
          <span class="volume-off" aria-hidden="true">×</span>
        </button>
        <label class="sr-only" for="night-signal-volume">音量</label>
        <input id="night-signal-volume" data-music-volume type="range" min="0" max="1" value="0.72" step="0.01" />
      </div>
    </div>

    <div class="music-drawer-tabs">
      <button type="button" data-music-list-toggle aria-pressed="false">歌单 <span data-music-count>{initialTrackCounter}</span></button>
      <button type="button" data-music-lyrics-toggle aria-pressed="false">逐行歌词 <span>LYRICS</span></button>
    </div>
    <div class="music-drawer" data-music-list hidden><ol data-music-playlist></ol></div>
    <div class="music-drawer music-lyrics-drawer" data-music-lyrics-list hidden><ol></ol></div>

    <footer class="music-credit">
      <span data-music-provider>网易云音乐 · 部署时同步</span>
      <a data-music-source href={firstTrack ? `https://music.163.com/#/song?id=${firstTrack.id}` : 'https://music.163.com/'} target="_blank" rel="noreferrer">歌曲页面与版权信息 ↗</a>
    </footer>
  </section>

  <script is:inline type="application/json" data-music-config set:html={serializedConfig}></script>
  <p class="sr-only" data-music-announcement aria-live="polite"></p>
</aside>

<script>
  type PlayMode = 'list' | 'single' | 'shuffle';
  type Drawer = 'playlist' | 'lyrics' | null;
  type TrackSeed = {
    id: string;
    title: string;
    artist: string;
    note: string;
    albumId?: string;
    albumTitle?: string;
    trackNumber?: number;
    lyricKind?: string;
  };
  type Track = TrackSeed & {
    cover: string;
    src: string;
    source: string;
    lrc: string;
    provider: 'netease' | 'fallback';
  };
  type LyricLine = { time: number; text: string };
  type PlayerConfig = { manifest: string; tracks: TrackSeed[]; fallback: Track };
  type PlayerState = {
    version: 2;
    trackId?: string;
    currentTime?: number;
    positions?: Record<string, number>;
    volume?: number;
    muted?: boolean;
    expanded?: boolean;
    mode?: PlayMode;
    drawer?: Drawer;
  };

  const STORAGE_KEY = 'ar-player:v2';
  const LEGACY_STORAGE_KEY = 'ar-player:v1';

  function formatTime(value: number) {
    if (!Number.isFinite(value) || value < 0) return '0:00';
    const minutes = Math.floor(value / 60);
    const seconds = Math.floor(value % 60).toString().padStart(2, '0');
    return `${minutes}:${seconds}`;
  }

  function parseLrc(lrcText: string): LyricLine[] {
    if (!lrcText || lrcText.length > 30_000) return [];
    const result: LyricLine[] = [];
    for (const line of lrcText.split(/\r?\n/)) {
      const matches = [...line.matchAll(/\[(\d{1,3}):(\d{2})(?:\.(\d{2,3}))?\]/g)];
      if (matches.length === 0) continue;
      const text = line
        .replace(/\[\d{1,3}:\d{2}(?:\.\d{2,3})?\]/g, '')
        .replace(/[\u0000-\u001F\u007F-\u009F\u200B-\u200D\uFEFF]/g, '')
        .trim();
      if (!text) continue;
      matches.forEach((match) => {
        const minutes = Number(match[1]);
        const seconds = Number(match[2]);
        const fraction = match[3] ? Number(match[3]) / (match[3].length === 3 ? 1000 : 100) : 0;
        result.push({ time: minutes * 60 + seconds + fraction, text });
      });
    }
    return result.sort((a, b) => a.time - b.time);
  }

  function findLyricIndex(lines: LyricLine[], currentTime: number) {
    let low = 0;
    let high = lines.length - 1;
    let answer = -1;
    while (low <= high) {
      const middle = Math.floor((low + high) / 2);
      if ((lines[middle]?.time ?? Infinity) <= currentTime) {
        answer = middle;
        low = middle + 1;
      } else {
        high = middle - 1;
      }
    }
    return answer;
  }

  function readState(): PlayerState {
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null') as unknown;
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed) && (parsed as { version?: unknown }).version === 2) {
        const candidate = parsed as Record<string, unknown>;
        const rawPositions = candidate.positions;
        const positions: Record<string, number> = {};
        if (rawPositions && typeof rawPositions === 'object' && !Array.isArray(rawPositions)) {
          Object.entries(rawPositions as Record<string, unknown>).forEach(([id, value]) => {
            const position = Number(value);
            if (id.length <= 128 && Number.isFinite(position) && position >= 0 && position <= 86_400) positions[id] = position;
          });
        }
        const volume = Number(candidate.volume);
        const currentTime = Number(candidate.currentTime);
        const mode = candidate.mode === 'single' || candidate.mode === 'shuffle' ? candidate.mode : 'list';
        const drawer = candidate.drawer === 'playlist' || candidate.drawer === 'lyrics' ? candidate.drawer : null;
        return {
          version: 2,
          trackId: typeof candidate.trackId === 'string' && candidate.trackId.length <= 128 ? candidate.trackId : undefined,
          currentTime: Number.isFinite(currentTime) && currentTime >= 0 && currentTime <= 86_400 ? currentTime : 0,
          positions,
          volume: Number.isFinite(volume) ? Math.min(1, Math.max(0, volume)) : 0.72,
          muted: typeof candidate.muted === 'boolean' ? candidate.muted : false,
          expanded: typeof candidate.expanded === 'boolean' ? candidate.expanded : false,
          mode,
          drawer,
        };
      }
      const legacy = JSON.parse(localStorage.getItem(LEGACY_STORAGE_KEY) || '{}') as Record<string, unknown>;
      const legacyTime = Number(legacy.currentTime);
      const legacyVolume = Number(legacy.volume);
      return {
        version: 2,
        currentTime: Number.isFinite(legacyTime) && legacyTime >= 0 && legacyTime <= 86_400 ? legacyTime : 0,
        volume: Number.isFinite(legacyVolume) ? Math.min(1, Math.max(0, legacyVolume)) : 0.72,
        muted: Boolean(legacy.muted),
        expanded: Boolean(legacy.expanded),
        mode: legacy.loop ? 'single' : 'list',
        drawer: null,
      };
    } catch {
      return { version: 2 };
    }
  }

  const musicWindow = window as Window & { __arMusicOpenHandler?: (event: Event) => void };

  function setupMusicDock() {
    const dock = document.querySelector<HTMLElement>('[data-music-dock]');
    if (!dock || dock.dataset.ready === 'true') return;

    const configNode = dock.querySelector<HTMLScriptElement>('[data-music-config]');
    const audio = dock.querySelector<HTMLAudioElement>('[data-music-audio]');
    const panel = dock.querySelector<HTMLElement>('[data-music-panel]');
    const compact = dock.querySelector<HTMLElement>('[data-music-compact]');
    const progress = dock.querySelector<HTMLInputElement>('[data-music-progress]');
    const volume = dock.querySelector<HTMLInputElement>('[data-music-volume]');
    const currentTimeNode = dock.querySelector<HTMLElement>('[data-music-current]');
    const durationNode = dock.querySelector<HTMLElement>('[data-music-duration]');
    const stateLabel = dock.querySelector<HTMLElement>('[data-music-state]');
    const announcement = dock.querySelector<HTMLElement>('[data-music-announcement]');
    const modeButton = dock.querySelector<HTMLButtonElement>('[data-music-mode]');
    const modeIcon = dock.querySelector<HTMLElement>('[data-music-mode-icon]');
    const modeLabel = dock.querySelector<HTMLElement>('[data-music-mode-label]');
    const muteButton = dock.querySelector<HTMLButtonElement>('[data-music-mute]');
    const previousButton = dock.querySelector<HTMLButtonElement>('[data-music-prev]');
    const nextButton = dock.querySelector<HTMLButtonElement>('[data-music-next]');
    const listToggle = dock.querySelector<HTMLButtonElement>('[data-music-list-toggle]');
    const lyricsToggle = dock.querySelector<HTMLButtonElement>('[data-music-lyrics-toggle]');
    const listDrawer = dock.querySelector<HTMLElement>('[data-music-list]');
    const lyricsDrawer = dock.querySelector<HTMLElement>('[data-music-lyrics-list]');
    const playlistNode = dock.querySelector<HTMLOListElement>('[data-music-playlist]');
    const lyricsListNode = lyricsDrawer?.querySelector<HTMLOListElement>('ol');
    const playButtons = Array.from(dock.querySelectorAll<HTMLButtonElement>('[data-music-play]'));
    const toggleButtons = Array.from(dock.querySelectorAll<HTMLButtonElement>('[data-music-toggle]'));
    if (!configNode || !audio || !panel || !compact || !progress || !volume || !currentTimeNode || !durationNode || !stateLabel || !modeButton || !modeIcon || !modeLabel || !listDrawer || !lyricsDrawer || !playlistNode || !lyricsListNode) return;

    let config: PlayerConfig;
    try { config = JSON.parse(configNode.textContent || '{}') as PlayerConfig; } catch { return; }
    if (!Array.isArray(config.tracks) || config.tracks.length === 0) return;
    dock.dataset.ready = 'true';

    const makeSeedTrack = (seed: TrackSeed): Track => ({
      ...seed,
      cover: '',
      src: `https://music.163.com/song/media/outer/url?id=${seed.id}.mp3`,
      source: `https://music.163.com/#/song?id=${seed.id}`,
      lrc: '',
      provider: 'netease',
    });
    let tracks = config.tracks.map(makeSeedTrack);
    const saved = readState();
    const positions: Record<string, number> = { ...(saved.positions || {}) };
    let currentIndex = Math.max(0, tracks.findIndex(track => track.id === saved.trackId));
    const savedTime = Math.max(0, Number(saved.currentTime) || 0);
    if (saved.trackId && !Object.prototype.hasOwnProperty.call(positions, saved.trackId)) positions[saved.trackId] = savedTime;
    if (!saved.trackId && savedTime > 0 && tracks[currentIndex]) positions[tracks[currentIndex].id] = savedTime;
    let playMode: PlayMode = ['list', 'single', 'shuffle'].includes(saved.mode || '') ? saved.mode as PlayMode : 'list';
    let activeDrawer: Drawer = saved.drawer === 'playlist' || saved.drawer === 'lyrics' ? saved.drawer : null;
    let currentLyrics: LyricLine[] = [];
    let currentLyricIndex = -2;
    let pendingResume = 0;
    let awaitingMetadata = false;
    let lastStoredSecond = -1;
    let playbackRequested = false;
    let initialized = false;
    let loadGeneration = 0;
    let handledFailureGeneration = -1;
    let manifestGeneration = 0;
    let manifestStatus: 'loading' | 'ready' | 'failed' = 'loading';
    let terminalError = '';
    const shuffleHistory: string[] = [];
    const lyricCache = new Map<string, { source: string; lines: LyricLine[] }>();
    const failedTracks = new Set<string>();

    const currentTrack = () => tracks[currentIndex] || tracks[0] || config.fallback;

    const persist = () => {
      const track = currentTrack();
      if (initialized && !awaitingMetadata && track && audio.dataset.trackId === track.id && Number.isFinite(audio.currentTime)) positions[track.id] = audio.currentTime;
      const next: PlayerState = {
        version: 2,
        trackId: track?.id,
        currentTime: audio.currentTime,
        positions,
        volume: audio.volume,
        muted: audio.muted,
        expanded: !panel.hidden,
        mode: playMode,
        drawer: activeDrawer,
      };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
        localStorage.removeItem(LEGACY_STORAGE_KEY);
      } catch { /* storage is optional */ }
    };

    const setText = (selector: string, text: string) => {
      const node = dock.querySelector<HTMLElement>(selector);
      if (node) node.textContent = text;
    };

    const updateMediaSession = (track: Track) => {
      if (!('mediaSession' in navigator) || !('MediaMetadata' in window)) return;
      navigator.mediaSession.metadata = new MediaMetadata({
        title: track.title,
        artist: track.artist,
        album: track.provider === 'netease' ? '亚略Ar · 网易云夜间信号' : '亚略Ar · 备用声音档案',
        artwork: track.cover ? [{ src: track.cover }] : [],
      });
    };

    const updateModeUI = () => {
      const modes: Record<PlayMode, { icon: string; label: string; next: string }> = {
        list: { icon: '↻', label: '列表循环', next: '单曲循环' },
        single: { icon: '↺¹', label: '单曲循环', next: '随机播放' },
        shuffle: { icon: '⌁', label: '随机播放', next: '列表循环' },
      };
      const mode = modes[playMode];
      modeIcon.textContent = mode.icon;
      modeLabel.textContent = mode.label;
      modeButton.setAttribute('aria-label', `当前为${mode.label}，点击切换为${mode.next}`);
      dock.dataset.playMode = playMode;
    };

    const setDrawer = (drawer: Drawer) => {
      activeDrawer = activeDrawer === drawer ? null : drawer;
      listDrawer.hidden = activeDrawer !== 'playlist';
      lyricsDrawer.hidden = activeDrawer !== 'lyrics';
      listToggle?.setAttribute('aria-pressed', String(activeDrawer === 'playlist'));
      lyricsToggle?.setAttribute('aria-pressed', String(activeDrawer === 'lyrics'));
      dock.classList.toggle('has-drawer', Boolean(activeDrawer));
      persist();
    };

    const setExpanded = (expanded: boolean, persistState = true, focusPanel = false) => {
      const focusWasInside = panel.contains(document.activeElement);
      panel.hidden = !expanded;
      compact.hidden = expanded;
      toggleButtons.forEach(button => button.setAttribute('aria-expanded', String(expanded)));
      dock.classList.toggle('is-expanded', expanded);
      if (persistState) persist();
      if (expanded && focusPanel) {
        requestAnimationFrame(() => panel.querySelector<HTMLButtonElement>('[data-music-play]')?.focus());
      } else if (!expanded && focusWasInside) {
        requestAnimationFrame(() => compact.querySelector<HTMLButtonElement>('[data-music-toggle]')?.focus());
      }
    };

    const renderPlaylist = () => {
      playlistNode.replaceChildren();
      let previousAlbumKey = '';
      tracks.forEach((track, index) => {
        const albumKey = track.albumId || track.albumTitle || '';
        if (albumKey && albumKey !== previousAlbumKey) {
          const group = document.createElement('li');
          group.className = 'music-playlist-group';
          const label = document.createElement('small');
          label.textContent = 'ALBUM / 专辑';
          const title = document.createElement('strong');
          title.textContent = track.albumTitle || `专辑 ${track.albumId}`;
          group.append(label, title);
          playlistNode.append(group);
          previousAlbumKey = albumKey;
        }
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.trackIndex = String(index);
        if (index === currentIndex) button.setAttribute('aria-current', 'true');
        const number = document.createElement('span');
        number.textContent = String(index + 1).padStart(2, '0');
        const copy = document.createElement('span');
        const title = document.createElement('strong');
        title.textContent = track.title;
        const artist = document.createElement('small');
        artist.textContent = track.artist;
        copy.append(title, artist);
        const status = document.createElement('i');
        status.textContent = index === currentIndex ? 'NOW' : '↗';
        button.append(number, copy, status);
        button.addEventListener('click', () => changeTrack(index, true, false));
        item.append(button);
        playlistNode.append(item);
      });
      setText('[data-music-count]', `${String(currentIndex + 1).padStart(2, '0')} / ${String(tracks.length).padStart(2, '0')}`);
    };

    const renderLyrics = () => {
      lyricsListNode.replaceChildren();
      if (currentLyrics.length === 0) {
        const item = document.createElement('li');
        item.className = 'music-lyrics-empty';
        item.textContent = currentTrack().lyricKind === 'instrumental'
          ? '器乐曲目：这里没有缺失的文字，只留下旋律本身。'
          : '这首歌暂时没有可用的逐行歌词。';
        lyricsListNode.append(item);
        return;
      }
      currentLyrics.forEach((line, index) => {
        const item = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.lyricIndex = String(index);
        const time = document.createElement('time');
        time.textContent = formatTime(line.time);
        const text = document.createElement('span');
        text.textContent = line.text;
        button.append(time, text);
        button.addEventListener('click', () => {
          if (audio.readyState >= 1) {
            audio.currentTime = line.time;
            updateLyric(true);
          } else {
            pendingResume = line.time;
          }
          if (audio.paused) void togglePlay();
        });
        item.append(button);
        lyricsListNode.append(item);
      });
    };

    const updateLyric = (force = false) => {
      const nextIndex = findLyricIndex(currentLyrics, audio.currentTime);
      if (!force && nextIndex === currentLyricIndex) return;
      currentLyricIndex = nextIndex;
      const emptyLine = currentTrack().lyricKind === 'instrumental' ? '♪ 器乐段落 ♪' : '♪ 暂无可用歌词 ♪';
      const currentLine = nextIndex >= 0 ? currentLyrics[nextIndex]?.text : (currentLyrics.length > 0 ? '♪ 前奏 ♪' : emptyLine);
      const nextLine = currentLyrics[nextIndex + 1]?.text || '';
      setText('[data-music-lyric]', currentLine || '♪ 纯享音乐 ♪');
      setText('[data-compact-lyric]', currentLine || '♪ 纯享音乐 ♪');
      setText('[data-music-next-lyric]', nextLine);
      const lyricButtons = Array.from(lyricsListNode.querySelectorAll<HTMLButtonElement>('[data-lyric-index]'));
      lyricButtons.forEach((button, index) => {
        const active = index === nextIndex;
        button.classList.toggle('active', active);
        if (active) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
      const active = lyricButtons[nextIndex];
      if (active && activeDrawer === 'lyrics') {
        const drawerRect = lyricsDrawer.getBoundingClientRect();
        const activeRect = active.getBoundingClientRect();
        const topDelta = activeRect.top - drawerRect.top;
        const bottomDelta = activeRect.bottom - drawerRect.bottom;
        const delta = topDelta < 0 ? topDelta : bottomDelta > 0 ? bottomDelta : 0;
        if (delta !== 0) {
          lyricsDrawer.scrollTo({
            top: lyricsDrawer.scrollTop + delta,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }
      }
    };

    const applyLyrics = (track: Track) => {
      const cached = lyricCache.get(track.id);
      currentLyrics = cached?.source === track.lrc ? cached.lines : parseLrc(track.lrc);
      lyricCache.set(track.id, { source: track.lrc, lines: currentLyrics });
      currentLyricIndex = -2;
      renderLyrics();
      updateLyric(true);
    };

    const updateTrackUI = (track: Track) => {
      setText('[data-compact-title]', track.title);
      setText('[data-music-title]', track.title);
      setText('[data-music-artist]', track.artist);
      setText('[data-music-note]', track.note);
      setText('[data-music-lyric-label]', track.lyricKind === 'instrumental' ? 'INSTRUMENTAL / 器乐曲目' : 'CURRENT LYRIC / 当前歌词');
      setText('[data-music-provider]', track.provider === 'netease' ? '网易云音乐 · 部署时同步歌词' : 'CC0 · 备用声音档案');
      const source = dock.querySelector<HTMLAnchorElement>('[data-music-source]');
      if (source) source.href = track.source;
      const cover = dock.querySelector<HTMLImageElement>('[data-music-cover]');
      if (cover) {
        if (track.cover) {
          cover.hidden = false;
          cover.src = track.cover;
        } else {
          cover.hidden = true;
          cover.removeAttribute('src');
        }
      }
      playButtons.forEach(button => button.setAttribute('aria-label', `${audio.paused ? '播放' : '暂停'} ${track.title}`));
      updateMediaSession(track);
      renderPlaylist();
    };

    const setPlayingUI = () => {
      const playing = !audio.paused && !audio.ended;
      const track = currentTrack();
      dock.classList.toggle('is-playing', playing);
      playButtons.forEach((button) => {
        button.setAttribute('aria-label', `${playing ? '暂停' : '播放'} ${track.title}`);
        button.setAttribute('aria-pressed', String(playing));
      });
      if (terminalError) stateLabel.textContent = terminalError;
      else if (playing) stateLabel.textContent = track.provider === 'netease' ? '网易云信号接收中' : '备用声音档案播放中';
      else if (audio.currentTime > 1) stateLabel.textContent = `停在 ${formatTime(audio.currentTime)} · ${track.title}`;
      else if (track.provider === 'fallback') stateLabel.textContent = '已切换至备用音源';
      else if (manifestStatus === 'failed') stateLabel.textContent = '歌词同步文件暂不可用，音频仍可尝试播放';
      else if (manifestStatus === 'ready') stateLabel.textContent = `已接入 ${tracks.filter(item => item.provider === 'netease').length} 首曲目与 LRC 信息`;
      else stateLabel.textContent = '等待一次主动的播放';
    };

    const updateTimeline = () => {
      const total = Number.isFinite(audio.duration) ? audio.duration : 0;
      const ratio = total > 0 ? audio.currentTime / total : 0;
      progress.value = String(Math.round(ratio * 1000));
      progress.style.setProperty('--progress', `${ratio * 100}%`);
      currentTimeNode.textContent = formatTime(audio.currentTime);
      durationNode.textContent = total > 0 ? formatTime(total) : '–:––';
      progress.setAttribute('aria-valuetext', `${formatTime(audio.currentTime)} / ${total > 0 ? formatTime(total) : '未知时长'}`);
      updateLyric();

      const wholeSecond = Math.floor(audio.currentTime);
      if (wholeSecond !== lastStoredSecond && wholeSecond % 2 === 0) {
        lastStoredSecond = wholeSecond;
        persist();
      }
    };

    const isPlayable = (track: Track) => track.provider === 'fallback' || !failedTracks.has(track.id);

    const randomIndex = () => {
      const candidates = tracks
        .map((track, index) => ({ track, index }))
        .filter(item => item.index !== currentIndex && isPlayable(item.track));
      return candidates.length > 0
        ? candidates[Math.floor(Math.random() * candidates.length)]?.index ?? currentIndex
        : currentIndex;
    };

    const nextIndex = (direction = 1) => {
      if (playMode === 'shuffle') {
        if (direction < 0) {
          while (shuffleHistory.length > 0) {
            const previousId = shuffleHistory.pop();
            const previousIndex = tracks.findIndex(track => track.id === previousId && isPlayable(track));
            if (previousIndex >= 0 && previousIndex !== currentIndex) return previousIndex;
          }
          for (let step = 1; step < tracks.length; step += 1) {
            const candidate = (currentIndex - step + tracks.length) % tracks.length;
            if (isPlayable(tracks[candidate])) return candidate;
          }
          return currentIndex;
        }
        const candidate = randomIndex();
        if (candidate !== currentIndex) {
          shuffleHistory.push(currentTrack().id);
          if (shuffleHistory.length > 50) shuffleHistory.shift();
        }
        return candidate;
      }
      for (let step = 1; step <= tracks.length; step += 1) {
        const candidate = (currentIndex + direction * step + tracks.length * 2) % tracks.length;
        if (isPlayable(tracks[candidate])) return candidate;
      }
      return currentIndex;
    };

    const changeTrack = (index: number, autoplay = playbackRequested, restore = false, initialLoad = false, recordHistory = true) => {
      if (tracks.length === 0) return;
      const oldTrack = currentTrack();
      const targetIndex = (index + tracks.length) % tracks.length;
      const targetTrack = tracks[targetIndex] || tracks[0] || config.fallback;
      const resumePosition = restore ? Math.max(0, Number(positions[targetTrack.id]) || 0) : 0;
      if (!initialLoad && oldTrack && audio.dataset.trackId === oldTrack.id && Number.isFinite(audio.currentTime)) positions[oldTrack.id] = audio.currentTime;
      if (!initialLoad && recordHistory && playMode === 'shuffle' && oldTrack.id !== targetTrack.id && shuffleHistory.at(-1) !== oldTrack.id) {
        shuffleHistory.push(oldTrack.id);
        if (shuffleHistory.length > 50) shuffleHistory.shift();
      }
      currentIndex = targetIndex;
      const track = currentTrack();
      pendingResume = resumePosition;
      awaitingMetadata = true;
      terminalError = '';
      loadGeneration += 1;
      handledFailureGeneration = -1;
      const generation = loadGeneration;
      currentLyrics = [];
      currentLyricIndex = -2;
      updateTrackUI(track);
      applyLyrics(track);
      audio.src = track.src;
      audio.dataset.trackId = track.id;
      audio.load();
      stateLabel.textContent = `正在连接 ${track.title}`;
      if (announcement) announcement.textContent = `已切换到 ${track.title}，${track.artist}`;
      if (autoplay) {
        playbackRequested = true;
        void attemptPlay(generation);
      }
      if (initialized) persist();
    };

    const attemptPlay = async (generation = loadGeneration) => {
      playbackRequested = true;
      try {
        await audio.play();
      } catch {
        if (generation !== loadGeneration) return;
        if (audio.error) {
          handleTrackFailure(generation);
          return;
        }
        playbackRequested = false;
        stateLabel.textContent = '请再次按下播放以继续';
        if (announcement) announcement.textContent = '浏览器暂未允许播放，请再次按下播放。';
        setPlayingUI();
      }
    };

    const togglePlay = async () => {
      if (audio.paused) await attemptPlay();
      else {
        playbackRequested = false;
        audio.pause();
      }
    };

    const moveToNextPlayable = (autoplay = playbackRequested) => {
      const available = tracks
        .map((track, index) => ({ track, index }))
        .filter(item => isPlayable(item.track));
      if (available.length > 0) {
        const next = available.find(item => item.index > currentIndex) || available[0];
        if (next) changeTrack(next.index, autoplay, false, false, false);
        return;
      }
      if (!tracks.some(track => track.id === config.fallback.id)) tracks.push(config.fallback);
      stateLabel.textContent = '网易云链路不可用，已切换备用音源';
      changeTrack(tracks.findIndex(track => track.id === config.fallback.id), autoplay, false, false, false);
    };

    const handleTrackFailure = (generation: number) => {
      if (generation !== loadGeneration || handledFailureGeneration === generation) return;
      const track = currentTrack();
      if (audio.dataset.trackId !== track.id) return;
      handledFailureGeneration = generation;
      if (track.provider === 'fallback') {
        playbackRequested = false;
        terminalError = '所有声音链路暂时不可用';
        if (announcement) announcement.textContent = terminalError;
        setPlayingUI();
        return;
      }
      failedTracks.add(track.id);
      const shouldContinue = playbackRequested;
      stateLabel.textContent = `${track.title} 暂时不可用，正在尝试下一首`;
      if (announcement) announcement.textContent = `${track.title} 无法播放，正在尝试下一首。`;
      moveToNextPlayable(shouldContinue);
    };

    const hydrateManifest = async () => {
      const requestGeneration = ++manifestGeneration;
      try {
        const response = await fetch(config.manifest, { cache: 'no-cache' });
        if (!response.ok) throw new Error(`manifest ${response.status}`);
        const manifest = await response.json() as { tracks?: Track[] };
        if (requestGeneration !== manifestGeneration) return;
        const resolved = Array.isArray(manifest.tracks)
          ? manifest.tracks.filter(track => track && /^\d{1,20}$/.test(String(track.id)) && track.src)
          : [];
        if (resolved.length === 0) throw new Error('empty manifest');
        const selectedTrack = currentTrack();
        const selectedId = audio.dataset.trackId || selectedTrack.id;
        const resolvedTracks = resolved.map(track => ({ ...track, provider: 'netease' as const }));
        const resolvedById = new Map(resolvedTracks.map(track => [track.id, track]));
        const merged = tracks.map(track => track.provider === 'fallback' ? track : (resolvedById.get(track.id) || track));
        resolvedTracks.forEach(track => {
          if (!merged.some(item => item.id === track.id)) merged.push(track);
        });
        tracks = merged;
        currentIndex = tracks.findIndex(track => track.id === selectedId);
        if (currentIndex < 0) {
          tracks.push(selectedTrack);
          currentIndex = tracks.length - 1;
        }
        const track = currentTrack();
        manifestStatus = 'ready';
        if (audio.dataset.trackId === track.id && audio.src !== track.src) {
          positions[track.id] = Number.isFinite(audio.currentTime) ? audio.currentTime : 0;
          changeTrack(currentIndex, playbackRequested, true, false, false);
        } else {
          updateTrackUI(track);
          applyLyrics(track);
        }
        setPlayingUI();
      } catch {
        if (requestGeneration !== manifestGeneration) return;
        manifestStatus = 'failed';
        setText('[data-music-lyric]', '♪ 歌词链路暂时离线 ♪');
        setText('[data-compact-lyric]', '歌词链路暂时离线');
        setPlayingUI();
      }
    };

    const restoredVolume = Number(saved.volume);
    audio.volume = Number.isFinite(restoredVolume) ? Math.min(1, Math.max(0, restoredVolume)) : 0.72;
    audio.muted = Boolean(saved.muted);
    volume.value = String(audio.volume);
    volume.style.setProperty('--volume', `${audio.volume * 100}%`);
    setExpanded(Boolean(saved.expanded), false, false);
    updateModeUI();
    listDrawer.hidden = activeDrawer !== 'playlist';
    lyricsDrawer.hidden = activeDrawer !== 'lyrics';
    listToggle?.setAttribute('aria-pressed', String(activeDrawer === 'playlist'));
    lyricsToggle?.setAttribute('aria-pressed', String(activeDrawer === 'lyrics'));
    dock.classList.toggle('has-drawer', Boolean(activeDrawer));

    toggleButtons.forEach(button => button.addEventListener('click', () => {
      const expand = panel.hidden !== false;
      setExpanded(expand, true, expand);
    }));
    playButtons.forEach(button => button.addEventListener('click', () => { void togglePlay(); }));
    previousButton?.addEventListener('click', () => {
      if (audio.currentTime > 3) {
        audio.currentTime = 0;
        updateTimeline();
      } else changeTrack(nextIndex(-1), playbackRequested, false, false, false);
    });
    nextButton?.addEventListener('click', () => changeTrack(nextIndex(1), playbackRequested, false));
    modeButton.addEventListener('click', () => {
      playMode = playMode === 'list' ? 'single' : playMode === 'single' ? 'shuffle' : 'list';
      updateModeUI();
      persist();
    });
    listToggle?.addEventListener('click', () => setDrawer('playlist'));
    lyricsToggle?.addEventListener('click', () => setDrawer('lyrics'));

    progress.addEventListener('input', () => {
      if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
      audio.currentTime = (Number(progress.value) / 1000) * audio.duration;
      updateTimeline();
    });
    volume.addEventListener('input', () => {
      audio.volume = Number(volume.value);
      audio.muted = false;
      volume.style.setProperty('--volume', `${audio.volume * 100}%`);
      persist();
    });
    muteButton?.addEventListener('click', () => {
      audio.muted = !audio.muted;
      persist();
    });

    audio.addEventListener('loadedmetadata', () => {
      if (pendingResume > 0 && pendingResume < audio.duration - 2) audio.currentTime = pendingResume;
      pendingResume = 0;
      awaitingMetadata = false;
      updateTimeline();
      setPlayingUI();
      persist();
    });
    audio.addEventListener('timeupdate', updateTimeline);
    audio.addEventListener('durationchange', updateTimeline);
    audio.addEventListener('seeked', () => updateLyric(true));
    audio.addEventListener('play', () => {
      playbackRequested = true;
      setPlayingUI();
      const track = currentTrack();
      if (announcement) announcement.textContent = `正在播放 ${track.title}`;
    });
    audio.addEventListener('pause', () => {
      setPlayingUI();
      persist();
    });
    audio.addEventListener('ended', () => {
      if (playMode === 'single') {
        audio.currentTime = 0;
        void attemptPlay();
      } else changeTrack(nextIndex(1), true, false);
    });
    audio.addEventListener('volumechange', () => {
      dock.classList.toggle('is-muted', audio.muted || audio.volume === 0);
      muteButton?.setAttribute('aria-pressed', String(audio.muted));
      muteButton?.setAttribute('aria-label', audio.muted ? '恢复声音' : '静音');
      persist();
    });
    audio.addEventListener('error', () => handleTrackFailure(loadGeneration));
    dock.querySelector<HTMLImageElement>('[data-music-cover]')?.addEventListener('error', (event) => {
      const image = event.currentTarget;
      if (image instanceof HTMLImageElement) image.hidden = true;
    });
    window.addEventListener('pagehide', persist);

    if (musicWindow.__arMusicOpenHandler) document.removeEventListener('click', musicWindow.__arMusicOpenHandler);
    musicWindow.__arMusicOpenHandler = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element) || !target.closest('[data-open-music]')) return;
      setExpanded(true, true, true);
    };
    document.addEventListener('click', musicWindow.__arMusicOpenHandler);

    try {
      navigator.mediaSession?.setActionHandler('play', () => { void attemptPlay(); });
      navigator.mediaSession?.setActionHandler('pause', () => { playbackRequested = false; audio.pause(); });
      navigator.mediaSession?.setActionHandler('nexttrack', () => changeTrack(nextIndex(1), true, false));
      navigator.mediaSession?.setActionHandler('previoustrack', () => changeTrack(nextIndex(-1), true, false, false, false));
      navigator.mediaSession?.setActionHandler('seekto', (details) => {
        if (typeof details.seekTime === 'number') audio.currentTime = details.seekTime;
      });
    } catch { /* unsupported media session action */ }

    changeTrack(currentIndex, false, true, true, false);
    initialized = true;
    void hydrateManifest();
    dock.classList.toggle('is-muted', audio.muted || audio.volume === 0);
    updateTimeline();
    setPlayingUI();
  }

  document.addEventListener('astro:page-load', setupMusicDock);
  setupMusicDock();
</script>
