---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-symbol" aria-hidden="true"><span></span><i></i></div>
  <div class="footer-grid page-width">
    <div>
      <a class="footer-brand" href="/">亚略<span>Ar</span></a>
      <p>{site.description}</p>
      <p class="footer-letter">谢谢你走到这一页的灯尽头。愿知识有尺度，故事有温度，远方也有人同行。</p>
    </div>
    <div class="footer-index">
      <p class="eyebrow">INDEX / 索引</p>
      <a href="/notes/">物理与技术笔记</a>
      <a href="/writing/">文学与幻想叙事</a>
      <a href="/projects/">项目档案</a>
    </div>
    <div class="footer-meta">
      <p class="eyebrow">COORDINATES / 坐标</p>
      <p>31.2304° N · 121.4737° E</p>
      <p>Shanghai, China</p>
    </div>
  </div>
  <div class="footer-bottom page-width">
    <span>© {year} 亚略Ar</span>
    <span>Built with Astro · Written in Markdown</span>
    <span class="footer-links"><a href="/rss.xml">RSS</a><a href="#main">回到页首 ↑</a></span>
  </div>
</footer>
