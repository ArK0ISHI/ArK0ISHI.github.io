---
import { site } from '../data/site';
import MoonGate from './MoonGate.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-grid page-width">
    <div>
      <a class="footer-brand" href="/">亚略<span>Ar</span></a>
      <p>{site.description}</p>
      <p class="footer-letter">谢谢你读到这里。愿知识有尺度，故事有温度，远方也有人同行。</p>
    </div>
    <nav class="footer-index" aria-label="页脚栏目导航">
      <p class="eyebrow">INDEX / 索引</p>
      <div class="footer-index-links">
        <a href="/notes/">物理与技术笔记</a>
        <a href="/projects/">项目与研究档案</a>
        <a href="/lab/">桌上的互动小实验</a>
        <a href="/writing/">文学与幻想叙事</a>
        <a href="/library/">书架与长篇阅读</a>
        <a href="/light-notes/">光影与旅途札记</a>
        <a href="/rhythm/">音游与节奏记录</a>
        <a href="/projects/future-scientists-handbook/">研学手册与信息设计</a>
        <a href="/about/">关于亚略 Ar</a>
      </div>
    </nav>
    <div class="footer-meta">
      <p class="eyebrow">COORDINATES / 坐标</p>
      <p>SHANGHAI · 31° N</p>
      <a class="footer-experience" href="/experience/">经历与公开边界 <span aria-hidden="true">↗</span></a>
      <MoonGate />
    </div>
  </div>
  <div class="footer-bottom page-width">
    <span>© {year} 亚略Ar</span>
    <span class="footer-signature">物理 · 写作 · 光影</span>
    <span class="footer-links"><a href="/rss.xml" aria-label="通过 RSS 订阅文章更新">RSS 订阅</a><a href="#main">回到页首 ↑</a></span>
  </div>
</footer>
