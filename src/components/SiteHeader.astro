---
import { navItems, site } from '../data/site';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href) || (href === '/projects/' && pathname.startsWith('/lab/'));
---

<header class:list={['site-header', { 'is-home': isHome }]} data-header>
  <a class="skip-link" href="#main">跳至正文</a>
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${site.name} 首页`}>
      <span class="brand-mark" aria-hidden="true"><Image src={avatar} width={96} height={96} widths={[48, 96]} sizes="42px" format="webp" quality={90} alt="" loading="eager" decoding="async" /></span>
      <span class="brand-name">亚略<span>Ar</span></span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navItems.map((item) => (
        <a class:list={['nav-link', { active: isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span>{item.label}</span>
          <small>{item.en}</small>
        </a>
      ))}
      <a class:list={['nav-link', 'moon-nav-link', { active: isActive('/moon/') }]} href="/moon/" aria-current={isActive('/moon/') ? 'page' : undefined} data-moon-nav hidden>
        <span>月之暗面</span><small>Far Side</small>
      </a>
    </nav>

    <div class="header-actions">
      <button class="icon-button search-toggle" type="button" data-search-trigger aria-label="检索文章与项目" title="检索（Ctrl/⌘ + K）">
        <span class="search-label">检索</span>
        <kbd>⌘ K</kbd>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.4"></circle><path d="m15.5 15.5 4 4"></path></svg>
      </button>
      <button class="icon-button theme-toggle" type="button" aria-label="切换深浅色模式" title="切换深浅色模式">
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path></svg>
      </button>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="打开导航">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="移动端导航" hidden>
    {navItems.map((item, index) => (
      <a class:list={['mobile-link', { active: isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        <small>{String(index + 1).padStart(2, '0')}</small>
        <span>{item.label}</span>
        <em>{item.en}</em>
      </a>
    ))}
    <a class:list={['mobile-link', 'moon-mobile-link', { active: isActive('/moon/') }]} href="/moon/" aria-current={isActive('/moon/') ? 'page' : undefined} data-moon-nav hidden>
      <small>☾</small><span>月之暗面</span><em>Far Side</em>
    </a>
  </nav>
</header>

<script>
  const headerWindow = window as Window & { __arHeaderController?: AbortController; __arHeaderElement?: HTMLElement };

  function setupHeader() {
    const currentHeader = document.querySelector<HTMLElement>('[data-header]');
    if (currentHeader && headerWindow.__arHeaderElement === currentHeader && headerWindow.__arHeaderController && !headerWindow.__arHeaderController.signal.aborted) return;
    headerWindow.__arHeaderController?.abort();
    const controller = new AbortController();
    headerWindow.__arHeaderController = controller;
    headerWindow.__arHeaderElement = currentHeader ?? undefined;

    const root = document.documentElement;
    let stored: string | null = null;
    try { stored = localStorage.getItem('ar-theme'); } catch { /* keep system preference */ }
    const preferredDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = stored || (preferredDark ? 'dark' : 'light');

    document.querySelector('.theme-toggle')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('ar-theme', next); } catch { /* theme still changes for this visit */ }
    }, { signal: controller.signal });

    const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
    const menu = document.querySelector<HTMLElement>('#mobile-menu');
    const header = document.querySelector<HTMLElement>('[data-header]');
    const background = new Map<HTMLElement, boolean>();
    document.body.classList.remove('menu-open');
    const setMenu = (open: boolean, returnFocus = false) => {
      menuButton?.setAttribute('aria-expanded', String(open));
      menuButton?.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
      if (menu) menu.hidden = !open;
      document.body.classList.toggle('menu-open', open);
      if (open) {
        header?.classList.remove('hidden-header');
        document.querySelectorAll<HTMLElement>('body > main, body > footer, [data-music-dock]').forEach(element => {
          background.set(element, element.inert);
          element.inert = true;
        });
        menu?.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        background.forEach((wasInert, element) => { element.inert = wasInert; });
        background.clear();
      }
      if (returnFocus) menuButton?.focus();
    };
    menuButton?.addEventListener('click', () => {
      const open = menuButton.getAttribute('aria-expanded') === 'true';
      setMenu(!open);
    }, { signal: controller.signal });
    document.addEventListener('keydown', (event) => {
      if (menuButton?.getAttribute('aria-expanded') !== 'true') return;
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { setMenu(false, true); return; }
      if (event.key === 'Escape') { event.preventDefault(); setMenu(false, true); }
      if (event.key !== 'Tab') return;
      const stops = [...(header?.querySelectorAll<HTMLElement>('.header-inner a, .header-inner button, .mobile-nav a') ?? [])]
        .filter(element => element.getClientRects().length > 0 && !element.closest('[inert]'));
      const first = stops[0];
      const last = stops.at(-1);
      if (event.shiftKey && (document.activeElement === first || !header?.contains(document.activeElement))) {
        event.preventDefault(); last?.focus();
      } else if (!event.shiftKey && (document.activeElement === last || !header?.contains(document.activeElement))) {
        event.preventDefault(); first?.focus();
      }
    }, { capture: true, signal: controller.signal });
    menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false), { signal: controller.signal }));
    header?.querySelector('[data-search-trigger]')?.addEventListener('click', () => setMenu(false), { capture: true, signal: controller.signal });
    const closeMenuOnDesktop = () => {
      const hasMoon = header?.dataset.moonUnlocked === 'true';
      if (window.matchMedia(hasMoon ? '(min-width: 1101px)' : '(min-width: 901px)').matches) setMenu(false);
    };
    window.addEventListener('resize', closeMenuOnDesktop, { signal: controller.signal });
    document.addEventListener('ar:moon-state', () => queueMicrotask(closeMenuOnDesktop), { signal: controller.signal });
    controller.signal.addEventListener('abort', () => setMenu(false), { once: true });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal: controller.signal });

    let lastY = window.scrollY;
    header?.addEventListener('focusin', () => {
      header?.classList.remove('hidden-header');
      lastY = window.scrollY;
    }, { signal: controller.signal });
    const updateHeader = () => {
      const y = window.scrollY;
      const containsFocus = header?.contains(document.activeElement);
      header?.classList.toggle('scrolled', y > 16);
      header?.classList.toggle('hidden-header', y > lastY && y > 180 && !containsFocus && !document.body.classList.contains('menu-open'));
      lastY = y;
    };
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true, signal: controller.signal });
  }

  document.addEventListener('astro:page-load', setupHeader);
  setupHeader();
</script>

<style>
  [data-moon-nav][hidden] { display: none !important; }
  .moon-nav-link { padding-left: 12px; border-left: 1px solid var(--line); }
  .moon-nav-link span { color: var(--blue); font-size: 12px; letter-spacing: .04em; white-space: nowrap; }
  .moon-nav-link.active span { color: var(--red); }
  .moon-mobile-link small { color: var(--lamp); font-size: 17px; }
  @media (min-width: 1101px) {
    .site-header[data-moon-unlocked='true'] .header-inner { grid-template-columns: 160px minmax(0, 1fr) 120px; }
    .site-header[data-moon-unlocked='true'] .desktop-nav { gap: clamp(14px, 1.6vw, 22px); }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .site-header[data-moon-unlocked='true'] .header-inner { grid-template-columns: 1fr auto; }
    .site-header[data-moon-unlocked='true'] .desktop-nav { display: none; }
    .site-header[data-moon-unlocked='true'] .menu-button { display: grid; }
    .site-header[data-moon-unlocked='true'] .mobile-nav { position: fixed; inset: 84px 0 auto; height: calc(100dvh - 84px); overflow-y: auto; overscroll-behavior: contain; padding: 16px max(24px, calc((100vw - 800px) / 2)) 28px; background: var(--paper); color: var(--ink); }
    .site-header[data-moon-unlocked='true'] .mobile-nav:not([hidden]) { display: block; }
    .site-header[data-moon-unlocked='true'] .mobile-link { display: grid; grid-template-columns: 42px 1fr auto; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--line); }
    .site-header[data-moon-unlocked='true'] .mobile-link small, .site-header[data-moon-unlocked='true'] .mobile-link em { color: var(--ink-soft); font: 300 9px/1 var(--mono); letter-spacing: .1em; font-style: normal; text-transform: uppercase; }
    .site-header[data-moon-unlocked='true'] .mobile-link span { font-size: 24px; }
    .site-header[data-moon-unlocked='true'] .mobile-link.active span { color: var(--red); }
    .site-header[data-moon-unlocked='true'] .moon-mobile-link small { color: var(--lamp); font-size: 17px; }
    :global(body.menu-open) { overflow: hidden; }
    .site-header[data-moon-unlocked='true'] .mobile-nav a:focus-visible { outline: 2px solid var(--red); outline-offset: -2px; }
  }
</style>
