---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AmbientLayer from '../components/AmbientLayer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import '../styles/global.css';
import '../styles/night.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title = site.title,
  description = site.description,
  image = '/og-card.svg',
  noindex = false,
  bodyClass,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === site.title ? title : `${title}｜${site.name}`;
const siteIcon = await getImage({ src: avatar, width: 64, height: 64, format: 'png' });
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f4ed" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="keywords" content={site.keywords.join(',')} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href={siteIcon.src} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <title>{fullTitle}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        try {
          const stored = localStorage.getItem('ar-theme');
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = stored || (dark ? 'dark' : 'light');
        } catch (_) {}
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <AmbientLayer />
    <SiteHeader />
    <SearchPalette />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <MusicPlayer />
    <script>
      const revealWindow = window as Window & { __arRevealObserver?: IntersectionObserver };

      function setupReveals() {
        revealWindow.__arRevealObserver?.disconnect();
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          targets.forEach((element) => element.classList.add('revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.08 });
        revealWindow.__arRevealObserver = observer;
        targets.forEach((element) => observer.observe(element));
      }

      document.addEventListener('astro:page-load', setupReveals);
      setupReveals();
    </script>
  </body>
</html>
