---
import BaseLayout from './BaseLayout.astro';

const { title, description, date, updated, category, tags } = Astro.props;
const displayDate = date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description}>
  <article class="post-shell page-width">
    <header class="post-header">
      <div class="post-kicker">
        <a href={`/tags/${encodeURIComponent(category)}/`}>{category}</a>
        <span>ESSAY / NOTE</span>
      </div>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
      <div class="post-byline">
        <div><span>WORDS BY</span><strong>亚略Ar</strong></div>
        <div><span>PUBLISHED</span><time datetime={date.toISOString()}>{displayDate}</time></div>
        {updated && <div><span>REVISED</span><time datetime={updated.toISOString()}>{updated.toLocaleDateString('zh-CN')}</time></div>}
      </div>
    </header>

    <div class="post-grid">
      <aside class="post-aside">
        <a class="back-link" href="javascript:history.back()">← 返回</a>
        <div class="post-tags">
          <span>关键词</span>
          {tags.map((tag: string) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}
        </div>
      </aside>
      <div class="prose">
        <slot />
      </div>
    </div>

    <footer class="post-end">
      <span aria-hidden="true">∴</span>
      <p>文章结束 · 感谢阅读</p>
      <a href="/">回到首页</a>
    </footer>
  </article>
</BaseLayout>
