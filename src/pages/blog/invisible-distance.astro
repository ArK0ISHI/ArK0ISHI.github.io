---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/invisible-distance.css';

const post = await getEntry('blog', 'invisible-distance');
if (!post) throw new Error('Missing invisible-distance content entry');
const { Content, headings } = await render(post);
const title = post.data.title;
const description = post.data.description;
const readingHeadings = headings.filter((heading) => heading.depth === 2);
const gallery = [
  {
    src: '/images/works/invisible-distance/article-opening.jpg',
    alt: '《看不见的远方》刊载页 62 至 63，标题页、序言与冬夜列车开篇',
    index: 'P.62—63',
    caption: '从 120 日元的冬夜慢车出发，提出远方与观看的问题。',
    wide: true,
    page: false,
  },
  {
    src: '/images/works/invisible-distance/article-spread-02.jpg',
    alt: '《看不见的远方》刊载页 64 至 65，盲目的开端与可见性的盲点',
    index: 'P.64—65',
    caption: '碎裂的镜片改变了观看的位置，盲点由此进入叙述。',
    wide: false,
    page: false,
  },
  {
    src: '/images/works/invisible-distance/article-spread-03.jpg',
    alt: '《看不见的远方》刊载页 66 至 67，超反思、消极能力与德里达式重读',
    index: 'P.66—67',
    caption: '从超反思和消极能力转向痕迹、见证与素描事件。',
    wide: false,
    page: false,
  },
  {
    src: '/images/works/invisible-distance/article-spread-04.jpg',
    alt: '《看不见的远方》刊载页 68 至 69，痕迹、纪录与结语',
    index: 'P.68—69',
    caption: '站牌上的纪录、缺席者的痕迹与重新书写，共同通向结语。',
    wide: true,
    page: false,
  },
  {
    src: '/images/works/invisible-distance/article-page-70.jpg',
    alt: '《看不见的远方》第 70 页，全文结尾、参考文献与作者后记',
    index: 'P.70',
    caption: '全文结尾、参考文献与后记。文章在这一页结束。',
    wide: false,
    page: true,
  },
];
---

<BaseLayout title={title} description={description} image="/images/works/invisible-distance/backlog-cover-photo.jpg">
  <article class="work-archive" data-work-archive>
    <header class="work-hero">
      <div class="work-hero-copy">
        <a class="work-breadcrumb" href="/writing/">← WRITING / 返回写作</a>
        <p class="work-eyebrow">BACKLOG VOL.2 · 2026 / P.62—70</p>
        <h1>
          <span class="work-title-main">看不见的远方</span>
          <span class="work-title-sub">在 120 日元的价差里，<br />触摸可见性的盲点</span>
        </h1>
        <p class="work-deck">本文刊载于《Backlog Vol.2》第 62—70 页。这里同时提供连续阅读的文字版和最终装帧书页。</p>
        <div class="work-actions">
          <a href="#work-reading">阅读正文</a>
          <button type="button" data-open-work-gallery>打开书页浏览</button>
        </div>
      </div>

      <figure class="work-hero-visual">
        <img src="/images/works/invisible-distance/backlog-cover-photo.jpg" width="1800" height="1197" alt="《Backlog Vol.2》实体社刊封面照片" fetchpriority="high" />
        <figcaption>《Backlog Vol.2》实体成品 · 东华大学 Galgame 研究室群刊</figcaption>
      </figure>

      <dl class="work-meta" aria-label="作品信息">
        <div><dt>文章写作</dt><dd>亚略 Ar</dd></div>
        <div><dt>刊载</dt><dd>《Backlog Vol.2》</dd></div>
        <div><dt>页码 / 介质</dt><dd>62—70 · 哑粉纸彩印</dd></div>
        <div><dt>站内归档</dt><dd>2026.08 · 上海</dd></div>
      </dl>
    </header>

    <section class="work-section" id="work-thesis" aria-labelledby="work-thesis-title">
      <div class="work-section-heading">
        <p class="work-section-kicker">01 / THE QUESTION</p>
        <h2 id="work-thesis-title">远方也藏在<br />观看转身的片刻。</h2>
      </div>

      <div class="work-lead-grid">
        <div class="work-abstract">
          <p>《120日元之冬》把一个成年人和一个仍想再远一点的孩子放进冬夜慢车。隐形眼镜遗失，检票规则悬在身后，厕所、座位与无人站台组成临时的庇护所。120 日元标出了车票价格，旅途还在衡量另一件事：人怎样观看世界。</p>
          <p>文章沿着踩碎隐形眼镜、厕所躲检票、红绿双星和站牌题刻等场景，观察视觉如何离开抽离的全景位置，回到身体的局限、偶遇的温度和无法消除的盲点。</p>
          <p>梅洛-庞蒂把观看带回身体经验；德里达讨论缺席、痕迹与幽灵如何进入可见之物。两条线索在这部短小的视觉小说中相遇，价格由此通向价值。</p>
        </div>
        <blockquote class="work-pullquote">
          彼时，我们或许会惊异地发现，远方即在身侧。
          <cite>《看不见的远方》结尾</cite>
        </blockquote>
      </div>

      <div class="work-coordinates" aria-label="文章的三个论题坐标">
        <article class="work-coordinate">
          <span>01 / BODY</span>
          <h3>身体性的观看</h3>
          <p>观看者从来不在世界之外。眼睛、姿势、疲惫和移动共同决定我们能够看见什么。</p>
        </article>
        <article class="work-coordinate">
          <span>02 / TRACE</span>
          <h3>缺席留下的痕迹</h3>
          <p>未抵达的人、被覆盖的记录与幽灵般的在场，仍在影响现在。</p>
        </article>
        <article class="work-coordinate">
          <span>03 / VALUE</span>
          <h3>价格之外的远方</h3>
          <p>120 日元规定了车票的价格，却无法穷尽同行、偶遇与继续向前所拥有的价值。</p>
        </article>
      </div>
    </section>

    <section class="work-section work-reading-section" id="work-reading" aria-labelledby="work-reading-title">
      <div class="work-section-heading">
        <p class="work-section-kicker">02 / WEB READING</p>
        <h2 id="work-reading-title">网页正文</h2>
      </div>

      <div class="work-reading-layout" data-work-reader data-reading-size="standard">
        <aside class="work-reading-sidebar" aria-label="阅读辅助">
          <div class="work-reading-tools" data-reading-tools hidden>
            <div class="work-reading-progress-label"><span>阅读进度</span><span data-reading-percent>0%</span></div>
            <progress class="work-reading-progress" max="100" value="0" aria-label="正文阅读进度" data-reading-progress></progress>
            <div class="work-reading-size" role="group" aria-label="正文字号">
              <span>字号</span>
              <button type="button" data-reading-size-option="standard" aria-pressed="true">标准</button>
              <button type="button" data-reading-size-option="large" aria-pressed="false">大字</button>
            </div>
          </div>
          <details class="work-reading-toc" open data-reading-toc>
            <summary><span>CONTENTS / 正文目录</span><span class="work-reading-current" data-reading-current>{readingHeadings[0]?.text}</span></summary>
            <nav aria-label="正文目录">
              <ol>
                {readingHeadings.map((heading) => <li><a href={`#${heading.slug}`} data-reading-section-link>{heading.text}</a></li>)}
              </ol>
              <a class="work-reading-pages-link" href="#work-pages">转到原刊书页 ↓</a>
            </nav>
          </details>
        </aside>

        <div class="work-reading-paper">
          <div class="work-reading-note">
            <span>TEXT EDITION / 夜读</span>
            <p>正文逐页核对《Backlog Vol.2》P.62—70，以最终刊载版的字词、段落和参考文献为准。网页只调整换行。</p>
          </div>
          <div class="work-reading-body">
            <Content />
          </div>
        </div>
      </div>
    </section>

    <section class="work-section" id="work-pages" aria-labelledby="work-pages-title">
      <div class="work-section-heading">
        <p class="work-section-kicker">03 / PRINTED PAGES</p>
        <h2 id="work-pages-title">论文落到纸页以后，<br />版式也参与了论述。</h2>
      </div>
      <p class="work-gallery-intro">这里展示文章在社刊中的四个跨页与结尾单页。最后一张原图的右页已经进入下一篇文章，因此本页只保留 P.70。点击书页可放大。</p>

      <div class="work-gallery">
        {gallery.map((item, index) => (
          <figure class:list={['work-gallery-item', { 'is-wide': item.wide, 'is-page': item.page }]}>
            <button
              class="work-gallery-trigger"
              type="button"
              data-work-gallery-trigger
              data-gallery-index={index}
              data-gallery-src={item.src}
              data-gallery-alt={item.alt}
              data-gallery-caption={`${item.index} · ${item.caption}`}
              aria-label={`放大查看 ${item.index} 书页`}
            >
              <span class="work-gallery-frame"><img src={item.src} width={item.page ? 1000 : 1800} height={item.page ? 1378 : 1240} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></span>
              <figcaption class="work-gallery-caption"><span class="work-caption-index">{item.index}</span><span>{item.caption}</span></figcaption>
            </button>
          </figure>
        ))}
      </div>
    </section>

    <section class="work-section" id="work-object" aria-labelledby="work-object-title">
      <div class="work-section-heading">
        <p class="work-section-kicker">04 / THE OBJECT</p>
        <h2 id="work-object-title">它首先是一本可以被拿起、<br />翻动与偶然发现的书。</h2>
      </div>

      <div class="work-object-grid">
        <figure><img src="/images/works/invisible-distance/book-mark.jpg" width="1280" height="851" alt="《Backlog Vol.2》背封与书脊的实体细节" loading="lazy" decoding="async" /><figcaption>封底与书脊</figcaption></figure>
        <figure><img src="/images/works/invisible-distance/book-index.jpg" width="1280" height="851" alt="《Backlog Vol.2》目录和紫色纹样内页" loading="lazy" decoding="async" /><figcaption>目录与纹样</figcaption></figure>
        <figure><img src="/images/works/invisible-distance/book-layout.jpg" width="1280" height="851" alt="《Backlog Vol.2》彩色内页的文字与人物排版" loading="lazy" decoding="async" /><figcaption>图文版式</figcaption></figure>
        <figure><img src="/images/works/invisible-distance/book-game.jpg" width="1280" height="851" alt="《Backlog Vol.2》填空小游戏实体内页" loading="lazy" decoding="async" /><figcaption>填空小游戏</figcaption></figure>
      </div>
    </section>

    <section class="work-section" id="work-publication" aria-labelledby="work-publication-title">
      <div class="work-history">
        <div>
          <p class="work-history-label">05 / PUBLICATION MEMORY</p>
          <h2 id="work-publication-title">一本社刊的半年，<br />与许多人留下的手温。</h2>
        </div>
        <div class="work-history-copy">
          <p>《Backlog Vol.2》的制作接近半年，收录文学批评、作品鉴赏、电波小品、旅行记录和填空小游戏。版面、封绘与哑粉纸全彩印刷，最终把社团成员的兴趣装订成一本可以共同翻阅的书。</p>
          <p>本页聚焦我写下的《看不见的远方》，并完整保留社刊团队署名。封面、整刊设计、协力、美工与编辑校对的具体分工，以《Backlog Vol.2》版权页为准。</p>

          <aside class="work-history-note">
            <strong>关于当时的预订公告</strong>
            <p>首批预订曾附赠专属色纸、吧唧与随机 to 签色纸，公告中的预订群号为 <code>860332651</code>。这里将它保留为出版过程的历史记录；是否仍开放、赠品是否仍有效，请以研究室后续通知为准。</p>
          </aside>
        </div>
      </div>

      <div class="work-credits" aria-label="作品与出版署名说明">
        <div class="work-credit"><span class="work-credit-label">TEXT / 文章</span><strong>亚略 Ar</strong><p>《看不见的远方》写作与本页作品整理。</p></div>
        <div class="work-credit"><span class="work-credit-label">DESIGN / 整体设计与排版</span><strong>RLt</strong><p>《Backlog Vol.2》总体风格、文本样式与图文布局。</p></div>
        <div class="work-credit"><span class="work-credit-label">COVER / 封面绘制</span><strong>虾滑馆破奇</strong><p>社刊封面绘制；封面照片用于呈现实物成品。</p></div>
        <div class="work-credit"><span class="work-credit-label">EDIT / 编辑校对</span><strong>坂上白菜</strong><p>社刊编辑校对；刊物由东华大学 Galgame 研究室共同制作。</p></div>
      </div>
    </section>

    <footer class="work-ending">
      <p>感谢你读到这里。愿这个冬夜的故事，也为你的日常留下一处可以重新观看的远方。</p>
      <nav aria-label="作品页后续导航"><a href="/writing/">继续阅读写作</a><a href="/">回到小屋首页</a></nav>
    </footer>

    <dialog class="work-lightbox" data-work-lightbox aria-label="文章跨页浏览器">
      <div class="work-lightbox-inner">
        <div class="work-lightbox-toolbar"><span class="work-lightbox-count" data-lightbox-count>01 / 05</span><button class="work-lightbox-close" type="button" data-lightbox-close aria-label="关闭跨页浏览器">关闭</button></div>
        <figure><img data-lightbox-image src="/images/works/invisible-distance/article-opening.jpg" alt="" /><figcaption data-lightbox-caption></figcaption></figure>
        <button class="work-lightbox-nav is-prev" type="button" data-lightbox-prev aria-label="上一幅跨页">←</button>
        <button class="work-lightbox-nav is-next" type="button" data-lightbox-next aria-label="下一幅跨页">→</button>
      </div>
    </dialog>
  </article>
</BaseLayout>

<script>
  const workWindow = window as Window & { __arWorkArchiveController?: AbortController; __arWorkReaderController?: AbortController };

  function setupWorkReader() {
    workWindow.__arWorkReaderController?.abort();
    const root = document.querySelector<HTMLElement>('[data-work-reader]');
    const body = root?.querySelector<HTMLElement>('.work-reading-body');
    if (!root || !body) return;
    const controller = new AbortController();
    workWindow.__arWorkReaderController = controller;
    const { signal } = controller;
    const tools = root.querySelector<HTMLElement>('[data-reading-tools]');
    const progress = root.querySelector<HTMLProgressElement>('[data-reading-progress]');
    const percent = root.querySelector<HTMLElement>('[data-reading-percent]');
    const current = root.querySelector<HTMLElement>('[data-reading-current]');
    const toc = root.querySelector<HTMLDetailsElement>('[data-reading-toc]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-reading-size-option]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-reading-section-link]')];
    const sections = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    const narrow = window.matchMedia('(max-width: 980px)');
    const syncToc = () => { if (toc) toc.open = !narrow.matches; };
    syncToc();
    narrow.addEventListener('change', syncToc, { signal });

    let frame = 0;
    const update = () => {
      frame = 0;
      const offset = narrow.matches ? 94 : 118;
      const rect = body.getBoundingClientRect();
      const distance = Math.max(1, body.scrollHeight - innerHeight + offset);
      const value = Math.round(Math.max(0, Math.min(1, (offset - rect.top) / distance)) * 100);
      if (progress) progress.value = value;
      if (percent) percent.textContent = `${value}%`;
      let active = 0;
      sections.forEach((section, index) => { if (section && section.getBoundingClientRect().top <= offset + 16) active = index; });
      links.forEach((link, index) => {
        if (index === active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (current) current.textContent = links[active]?.textContent ?? '';
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    const setSize = (size: string) => {
      root.dataset.readingSize = size === 'large' ? 'large' : 'standard';
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.readingSizeOption === root.dataset.readingSize)));
      schedule();
    };
    try { setSize(localStorage.getItem('ar-work-reading-size') ?? 'standard'); } catch { setSize('standard'); }
    buttons.forEach(button => button.addEventListener('click', () => {
      setSize(button.dataset.readingSizeOption ?? 'standard');
      try { localStorage.setItem('ar-work-reading-size', root.dataset.readingSize ?? 'standard'); } catch { /* Reading controls also work without storage. */ }
    }, { signal }));
    links.forEach((link, index) => link.addEventListener('click', () => {
      if (narrow.matches && toc) toc.open = false;
      const heading = sections[index];
      heading?.setAttribute('tabindex', '-1');
      heading?.focus({ preventScroll: true });
      schedule();
    }, { signal }));
    window.addEventListener('scroll', schedule, { passive: true, signal });
    window.addEventListener('resize', schedule, { signal });
    const observer = new ResizeObserver(schedule);
    observer.observe(body);
    signal.addEventListener('abort', () => { observer.disconnect(); cancelAnimationFrame(frame); }, { once: true });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal });
    if (tools) tools.hidden = false;
    schedule();
  }

  function setupWorkArchive() {
    workWindow.__arWorkArchiveController?.abort();
    const controller = new AbortController();
    workWindow.__arWorkArchiveController = controller;

    const dialog = document.querySelector<HTMLDialogElement>('[data-work-lightbox]');
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-work-gallery-trigger]'));
    const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog?.querySelector<HTMLElement>('[data-lightbox-caption]');
    const count = dialog?.querySelector<HTMLElement>('[data-lightbox-count]');
    if (!dialog || !image || !caption || !count || triggers.length === 0) return;

    let current = 0;
    const render = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current];
      image.src = trigger.dataset.gallerySrc || '';
      image.alt = trigger.dataset.galleryAlt || '';
      caption.textContent = trigger.dataset.galleryCaption || '';
      count.textContent = `${String(current + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
    };
    const open = (index: number) => {
      render(index);
      dialog.showModal();
      dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.focus();
    };

    triggers.forEach((trigger, index) => trigger.addEventListener('click', () => open(index), { signal: controller.signal }));
    document.querySelector<HTMLButtonElement>('[data-open-work-gallery]')?.addEventListener('click', () => open(0), { signal: controller.signal });
    dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.addEventListener('click', () => dialog.close(), { signal: controller.signal });
    dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')?.addEventListener('click', () => render(current - 1), { signal: controller.signal });
    dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')?.addEventListener('click', () => render(current + 1), { signal: controller.signal });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); }, { signal: controller.signal });
    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') render(current - 1);
      if (event.key === 'ArrowRight') render(current + 1);
    }, { signal: controller.signal });
  }

  document.addEventListener('astro:page-load', setupWorkArchive);
  document.addEventListener('astro:page-load', setupWorkReader);
  setupWorkArchive();
  setupWorkReader();
</script>
