---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/profile-paths.css';

const items = [
  { year: '2026', title: '“华数杯”国际大学生数学建模竞赛一等奖', note: '数学建模与协作研究', href: '/blog/huashu-cup-a-2026/' },
  { year: '2026', title: '《当代中国高校筹款的伦理问题诊断及其对策建议》', note: '发表于《高教探索》2026年第1期 · 学生第一作者' },
  { year: '2025', title: '国家奖学金', note: '本科生国家奖学金' },
  { year: '2025', title: '全国大学生物理实验竞赛创新赛全国一等奖', note: '融合机器学习的差动式电容微位移测量', href: '/blog/capacitive-displacement/' },
  { year: '2025', title: 'CUPT 全国一等奖、全国最佳实验图片奖', note: '滴水龙头液滴特性的实验研究', href: '/blog/dripping-faucet-chaos/' },
  { year: '2024', title: '上海市奖学金', note: '上海市普通高等学校优秀学生奖学金' },
];
---

<BaseLayout title="经历" description="亚略Ar的精选荣誉、发表与经历时间线。">
  <header class="page-hero">
    <div class="page-hero-grid">
      <div><p class="eyebrow">EXPERIENCE / 经历</p><h1>刻度、记录<br />与<em>来路</em></h1></div>
      <p class="page-hero-description">奖项只标出某个阶段。这里保留必要的时间与背景，更完整的过程写在项目和文章里。</p>
    </div>
  </header>
  <section class="page-content profile-experience">
    <div class="page-controls"><span class="page-count">SELECTED · 2024—2026</span><a class="profile-return" href="/about/">回到关于页 <span aria-hidden="true">↗</span></a></div>
    <div class="experience-list">
      {items.map(item => (
        item.href ? (
          <a class="experience-row experience-row-link" href={item.href} aria-label={`阅读项目记录：${item.title}`} data-experience-project>
            <time>{item.year}</time><h2>{item.title}</h2><p>{item.note}<span class="experience-read-label">阅读项目记录 <span aria-hidden="true">→</span></span></p>
          </a>
        ) : (
          <div class="experience-row"><time>{item.year}</time><h2>{item.title}</h2><p>{item.note}</p></div>
        )
      ))}
    </div>
    <aside class="privacy-note">
      <h2>公开边界</h2>
      <p>为了让作品被看见，而不必让私人生活同时暴露，本站只保留与学习、研究和创作直接相关的信息，不公开班级、学号、手机号、详细住址或证书原件。</p>
    </aside>
  </section>
</BaseLayout>
