---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArticleRow from '../components/ArticleRow.astro';
import ProjectSpotlight from '../components/ProjectSpotlight.astro';
import { projects } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 4);
const welcomeRoutes = [
  { slug: 'why-this-site', prompt: '想知道这里为何存在', mark: '从一封开站说明开始' },
  { slug: 'capacitive-displacement', prompt: '想从一条公式开始', mark: '走进实验、标定与模型' },
  { slug: 'invisible-distance', prompt: '想从一个故事开始', mark: '翻到记忆与叙事的一页' },
].map(route => ({ ...route, post: posts.find(post => post.id === route.slug) })).filter(route => route.post);
const featuredProjects = projects.filter(project => project.featured);
const studentToolProject = projects.find(project => project.id === 'summer-camp-navigator');
const honors = [
  { year: '2025', title: '全国大学生物理实验竞赛创新赛全国一等奖', scope: 'PHYSICS EXPERIMENT' },
  { year: '2025', title: 'CUPT 全国一等奖、全国最佳实验图片奖', scope: 'CUPT' },
  { year: '2026', title: '“华数杯”国际大学生数学建模竞赛一等奖', scope: 'MODELING', href: '/blog/huashu-cup-a-2026/' },
];
---

<BaseLayout>
  <HomeHero />

  <section class="intro-strip">
    <div class="intro-inner page-width" data-reveal>
      <div class="intro-label">
        <p class="eyebrow">PROFILE / 简介</p>
        <strong>这里是亚略Ar。</strong>
      </div>
      <div class="intro-copy">
        <p>我是一名应用物理学本科生，关注基础物理、精密测量、微纳电子器件、光电信息与计算物理。</p>
        <p>在物理之外，我阅读并评论视觉小说与东方Project相关作品，也进行文本校订、书籍装帧和长篇写作。</p>
      </div>
      <div class="intro-facts">
        <div><span>BASE</span><strong>上海</strong></div>
        <div><span>FOCUS</span><strong>Physics × Text</strong></div>
        <div><span>TOOLS</span><strong>Py · MATLAB · TeX</strong></div>
      </div>
    </div>
  </section>

  <section id="tonight-log" class="home-section tonight-section" data-reveal>
    <SectionHeading index="00" title="书桌上的三条线索" en="Three Threads on the Desk" />
    <div class="tonight-log">
      <article class="log-entry">
        <p class="log-index">01 · MEASUREMENT</p>
        <h3>测量如何变得可信</h3>
        <p>从差动电容、重复测量与残差结构出发，整理微位移实验中容易被最终结果遮住的误差来源。</p>
      </article>
      <article class="log-entry">
        <p class="log-index">02 · MODEL</p>
        <h3>模型怎样承认边界</h3>
        <p>把线圈误差场与粒子轨道的数值工作写成可以回看的笔记，说明近似、步长与失效条件。</p>
      </article>
      <article class="log-entry is-listening">
        <p class="log-index">03 · SOUND ARCHIVE</p>
        <h3>给阅读留一段声音</h3>
        <p>声音档案现收进《卯酉東海道》、《大空魔術》与我的 solstice 歌单，共 44 首。它默认安静，等你主动按下播放，再沿着车窗、月面与夜色慢慢远行。</p>
        <button class="now-playing-link" type="button" data-open-music>打开夜间信号 <span>→</span></button>
      </article>
    </div>
    <figure class="night-letter">
      <blockquote>有些问题适合在实验室里回答，有些要等到回程路上才慢慢显出轮廓。这个站点想把两种时刻都留下来。</blockquote>
      <figcaption>
        <span><i></i>观测记录</span>
        <b aria-hidden="true"></b>
        <span><i></i>夜间回信</span>
      </figcaption>
    </figure>
  </section>

  <section id="first-visit" class="home-section" data-reveal>
    <SectionHeading index="01" title="如果你第一次来" en="Three Ways into the Archive" />
    <div class="welcome-paths">
      {welcomeRoutes.map((route, index) => route.post && (
        <a class="welcome-path" href={`/blog/${route.post.id}/`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><p>{route.prompt}</p><h3>{route.post.data.title}</h3><small>{route.mark}</small></div>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </section>

  <section id="projects" class="home-section" data-reveal>
    <SectionHeading index="02" title="精选项目" en="Selected Projects" href="/projects/" />
    <div class="featured-projects">
      {featuredProjects.map((project) => (
        <article class="featured-project">
          <div class="fp-top"><span class="fp-index">{project.number}</span><span>项目札记</span></div>
          <div class="fp-glyph" aria-hidden="true"></div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          {project.reflection && <p class="fp-reflection"><span>问题意识</span>{project.reflection}</p>}
          <div class="fp-result">{project.result}</div>
        </article>
      ))}
    </div>
    {studentToolProject && <ProjectSpotlight project={studentToolProject} />}
  </section>

  <section id="latest" class="home-section" data-reveal>
    <SectionHeading index="03" title="最近文章" en="Latest Notes & Essays" href="/notes/" />
    <div class="latest-list">
      {latest.map((post, index) => <ArticleRow post={post} number={String(index + 1).padStart(2, '0')} />)}
    </div>
  </section>

  <section class="home-section" data-reveal>
    <SectionHeading index="04" title="当前关注" en="Currently Exploring" />
    <div class="focus-grid">
      <p class="focus-statement">一个结果如何由<em>实验装置</em>、数学模型与计算方法共同产生？一个故事又如何被记忆与讲述？</p>
      <div class="focus-detail">
        <p>这个站点是一间持续生长的个人档案室：保存研究项目、课程笔记、技术工具、文学评论，以及一些尚未抵达的远方。</p>
        <ul class="focus-list">
          <li><span>01</span> 精密测量与微纳器件 <small>MEASUREMENT</small></li>
          <li><span>02</span> 数值模拟与计算物理 <small>COMPUTATION</small></li>
          <li><span>03</span> 视觉小说与东方叙事 <small>NARRATIVE</small></li>
          <li><span>04</span> LaTeX 装帧与文本校订 <small>TYPOGRAPHY</small></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="honor-band">
    <div class="honor-inner page-width" data-reveal>
      <div class="honor-intro">
        <p class="eyebrow">SELECTED HONORS / 荣誉</p>
        <h2>沿途留下的<br />一些刻度。</h2>
        <p>这里选出三项代表记录，完整清单与时间线收录在经历页面。</p>
        <a class="text-link" href="/experience/">查看完整经历 <span>↗</span></a>
      </div>
      <div class="honor-list">
        {honors.map(honor => (
          honor.href ? (
            <a class="honor-item honor-item-link" href={honor.href} aria-label={`阅读相关文章：${honor.title}`}>
              <span>{honor.year}</span><strong>{honor.title}</strong><small>{honor.scope}</small>
            </a>
          ) : (
            <div class="honor-item">
              <span>{honor.year}</span><strong>{honor.title}</strong><small>{honor.scope}</small>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
