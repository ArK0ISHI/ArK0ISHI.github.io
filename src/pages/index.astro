---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { projects } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 4);
const featuredProjects = projects.filter(project => project.featured);
const honors = [
  { year: '2025', title: '全国大学生物理实验竞赛创新赛全国一等奖', scope: 'PHYSICS EXPERIMENT' },
  { year: '2025', title: 'CUPT 全国一等奖、全国最佳实验图片奖', scope: 'CUPT' },
  { year: '2026', title: '“华数杯”国际大学生数学建模竞赛一等奖', scope: 'MODELING' },
];
---

<BaseLayout>
  <section class="home-hero">
    <div class="hero-copy" data-reveal>
      <p class="hero-overline">Night Field Notes · Shanghai · 31°N</p>
      <h1 class="hero-title">
        亚略<span class="latin">Ar</span>
        <span class="line">物理、计算与幻想叙事</span>
      </h1>
      <p class="hero-lede">白天与器件、数据相处，夜里读故事、修文字，<br />也记下那些暂时无法被测量的感受。</p>
      <p class="hero-human-note">愿每一条公式都有来处，也愿每一个故事都有人同行。</p>
      <div class="hero-actions">
        <a class="primary-link" href="/notes/">开始阅读 <span>↗</span></a>
        <a class="text-link" href="/about/">认识亚略Ar <span>→</span></a>
      </div>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="visual-axis"></div>
      <div class="orbit one"></div>
      <div class="orbit two"></div>
      <div class="orbit three"></div>
      <span class="observer-dot primary"></span>
      <span class="observer-dot secondary"></span>
      <div class="hero-monogram">Ar</div>
      <p class="coordinate top">OBSERVATION 23:47<br />31.2304° N / 121.4737° E</p>
      <p class="coordinate bottom">LAST TRAIN 00:12<br />VISIBLE &amp; INVISIBLE</p>
    </div>
    <div class="hero-scroll"><i></i><span>向下阅读 / Scroll</span></div>
  </section>

  <section class="intro-strip">
    <div class="intro-inner page-width" data-reveal>
      <div class="intro-label">
        <p class="eyebrow">PROFILE / 简介</p>
        <strong>这里是亚略Ar。</strong>
      </div>
      <div class="intro-copy">
        <p>我是一名应用物理学本科生，关注基础物理、精密测量、微纳电子器件、光电信息与计算物理。</p>
        <p>在物理之外，我阅读并评论视觉小说与东方Project相关作品，也进行文本校订、书籍装帧和长篇写作。</p>
      </div>
      <div class="intro-facts">
        <div><span>BASE</span><strong>上海</strong></div>
        <div><span>FOCUS</span><strong>Physics × Text</strong></div>
        <div><span>TOOLS</span><strong>Py · MATLAB · TeX</strong></div>
      </div>
    </div>
  </section>

  <section class="home-section tonight-section" data-reveal>
    <SectionHeading index="00" title="今晚的观测" en="Tonight's Field Log" />
    <div class="tonight-log">
      <article class="log-entry">
        <p class="log-index">01 · ON THE DESK</p>
        <h3>桌上正在做的事</h3>
        <p>把一段磁场程序里的误差追到最后一位；茶已经凉了两次，窗口仍亮着。</p>
      </article>
      <article class="log-entry">
        <p class="log-index">02 · BETWEEN PAGES</p>
        <h3>最近停留的书页</h3>
        <p>重读那些关于记忆与边界的故事，在页角留下一些铅笔写成的问号。</p>
      </article>
      <article class="log-entry is-listening">
        <p class="log-index">03 · NOW PLAYING</p>
        <h3>此刻正在听</h3>
        <p>肖邦《夜想曲 Op. 15 No. 2》——给夜行、阅读，以及还没有说完的话。</p>
        <button class="now-playing-link" type="button" data-open-music>打开夜间信号 <span>→</span></button>
      </article>
    </div>
    <figure class="night-letter">
      <blockquote>晚风把实验楼的灯一盏盏吹灭。我们仍在讨论：世界的边界究竟写在公式里，还是藏在回家的末班车窗上。</blockquote>
      <figcaption>
        <span><i></i>记录 · 23:47</span>
        <b aria-hidden="true"></b>
        <span><i></i>回信 · 00:12</span>
      </figcaption>
    </figure>
  </section>

  <section class="home-section" data-reveal>
    <SectionHeading index="01" title="精选项目" en="Selected Projects" href="/projects/" />
    <div class="featured-projects">
      {featuredProjects.map((project) => (
        <article class="featured-project">
          <div class="fp-top"><span class="fp-index">{project.number}</span><span>RESEARCH ARCHIVE</span></div>
          <div class="fp-glyph" aria-hidden="true"></div>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          {project.reflection && <p class="fp-reflection">“{project.reflection}”</p>}
          <div class="fp-result">{project.result}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section" data-reveal>
    <SectionHeading index="02" title="最近文章" en="Latest Notes & Essays" href="/notes/" />
    <div class="latest-list">
      {latest.map((post, index) => <ArticleRow post={post} number={String(index + 1).padStart(2, '0')} />)}
    </div>
  </section>

  <section class="home-section" data-reveal>
    <SectionHeading index="03" title="当前关注" en="Currently Exploring" />
    <div class="focus-grid">
      <p class="focus-statement">一个结果如何由<em>实验装置</em>、数学模型与计算方法共同产生？一个故事又如何被记忆与讲述？</p>
      <div class="focus-detail">
        <p>这个站点是一间持续生长的个人档案室：保存研究项目、课程笔记、技术工具、文学评论，以及一些尚未抵达的远方。</p>
        <ul class="focus-list">
          <li><span>01</span> 精密测量与微纳器件 <small>MEASUREMENT</small></li>
          <li><span>02</span> 数值模拟与计算物理 <small>COMPUTATION</small></li>
          <li><span>03</span> 视觉小说与东方叙事 <small>NARRATIVE</small></li>
          <li><span>04</span> LaTeX 装帧与文本校订 <small>TYPOGRAPHY</small></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="honor-band">
    <div class="honor-inner page-width" data-reveal>
      <div class="honor-intro">
        <p class="eyebrow">SELECTED HONORS / 荣誉</p>
        <h2>沿途留下的<br />一些刻度。</h2>
        <p>这里只陈列三项代表记录。完整清单与时间线收录在“经历”页面。</p>
        <a class="text-link" href="/experience/">查看完整经历 <span>↗</span></a>
      </div>
      <div class="honor-list">
        {honors.map(honor => (
          <div class="honor-item">
            <span>{honor.year}</span><strong>{honor.title}</strong><small>{honor.scope}</small>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
