---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeResearch from '../components/HomeResearch.astro';
import HomeExhibition from '../components/HomeExhibition.astro';
import HomeFieldnotes from '../components/HomeFieldnotes.astro';
import HomeRhythm from '../components/HomeRhythm.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { projects } from '../data/projects';
import { lightNotePhotos } from '../data/lightNotes';
import '../styles/home-edition.css';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const honors = [
  { year: '2025', title: '全国大学生物理实验竞赛创新赛全国一等奖', scope: 'PHYSICS EXPERIMENT' },
  { year: '2025', title: 'CUPT 全国一等奖、全国最佳实验图片奖', scope: 'CUPT' },
  { year: '2026', title: '“华数杯”国际大学生数学建模竞赛一等奖', scope: 'MODELING', href: '/blog/huashu-cup-a-2026/' },
];
---
<BaseLayout>
  <div class="home-edition">
    <HomeHero />
    <section id="tonight-log" class="edition-prologue page-width" aria-labelledby="prologue-title">
      <div class="prologue-title" data-reveal>
        <p class="edition-kicker">A NOTE FROM AR / 开卷</p>
        <h2 id="prologue-title">让结果有来路，<br />让热爱<em>有迹可循。</em></h2>
        <a class="edition-text-link" href="/blog/why-this-site/">关于这间小屋</a>
      </div>
      <div class="prologue-copy" data-reveal>
        <p class="prologue-name">你好，这里是亚略 Ar。</p>
        <p>我在上海学习应用物理。白天，关心一次测量为什么可信、一个模型在哪里失效；夜里，读视觉小说，写评论，也用 LaTeX 把长篇文字重新整理成书。</p>
        <p>这里保存做成的事，也保存中途的疑问。你可以从一条轨迹开始，或先翻开一本书。</p>
        <dl class="archive-counts">
          <div><dt>文章与笔记</dt><dd>{String(posts.length).padStart(2, '0')}<span>篇</span></dd></div>
          <div><dt>项目档案</dt><dd>{String(projects.length).padStart(2, '0')}<span>项</span></dd></div>
          <div><dt>行旅光影</dt><dd>{lightNotePhotos.length}<span>帧</span></dd></div>
        </dl>
      </div>
    </section>
    <nav class="edition-contents page-width" aria-label="首页篇章">
      <span>CONTENTS / 这一页</span>
      <a href="#research"><small>01</small>观测与计算</a>
      <a href="#writing-exhibition"><small>02</small>写作与书页</a>
      <a href="#fieldnotes"><small>03</small>行旅与光影</a>
      <a href="#rhythm-room"><small>04</small>节奏与记录</a>
      <a href="#latest"><small>05</small>近来的文字</a>
    </nav>
    <HomeResearch />
    <div id="writing-exhibition" class="edition-anchor"><HomeExhibition /></div>
    <div id="fieldnotes" class="edition-anchor"><HomeFieldnotes /></div>
    <HomeRhythm />
    <section id="latest" class="edition-reading page-width" aria-labelledby="reading-title" data-reading-room>
      <header class="edition-heading" data-reveal>
        <div><p class="edition-kicker">05 / NOTES & MARGINALIA</p><h2 id="reading-title">近来的<em>文字。</em></h2></div>
        <p>有时推导，有时回望。<br />把暂时想清楚的，认真写下来。</p>
      </header>
      <div class="reading-toolbar">
        <div class="reading-filters" role="group" aria-label="文章分类">
          <button type="button" aria-pressed="true" aria-controls="home-reading-results" data-reading-filter="all">全部</button>
          <button type="button" aria-pressed="false" aria-controls="home-reading-results" data-reading-filter="note">物理与计算</button>
          <button type="button" aria-pressed="false" aria-controls="home-reading-results" data-reading-filter="writing">文学与随笔</button>
        </div>
        <p class="reading-count" role="status" aria-live="polite" data-reading-count>{posts.length} 篇文字</p>
      </div>
      <div id="home-reading-results" class="edition-articles">
        {posts.map((post, index) => <div data-reading-item data-kind={post.data.kind}><ArticleRow post={post} number={String(index + 1).padStart(2, '0')} /></div>)}
      </div>
      <div class="reading-more-row"><button class="reading-more" type="button" aria-controls="home-reading-results" data-reading-more hidden>展开其余文章</button><a class="edition-text-link" href="/rss.xml">通过 RSS 订阅更新</a></div>
    </section>
    <section class="edition-afterword page-width" aria-labelledby="afterword-title" data-reveal>
      <p class="edition-kicker">THE ROOM STAYS OPEN / 页末</p>
      <h2 id="afterword-title">世界很大。<br />慢慢看，<em>慢慢写。</em></h2>
      <div><p>有些问题适合在实验室里回答，有些要等到回程路上才慢慢显出轮廓。愿这间小屋，能为两种时刻都留一盏灯。</p><a class="edition-text-link" href="/about/">再多认识我一点</a></div>
    </section>
    <section class="edition-honors" aria-labelledby="honors-title">
      <div class="page-width honors-layout">
        <div><p class="edition-kicker">SELECTED MILESTONES</p><h2 id="honors-title">沿途的刻度。</h2><a class="edition-text-link" href="/experience/">查看完整经历</a></div>
        <div class="edition-honor-list">{honors.map(honor => <div><time>{honor.year}</time><p>{honor.href ? <a href={honor.href}>{honor.title}</a> : honor.title}<small>{honor.scope}</small></p></div>)}</div>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  const editionWindow = window as Window & { __arEditionController?: AbortController };
  function setupReadingRoom() {
    editionWindow.__arEditionController?.abort();
    const root = document.querySelector<HTMLElement>('[data-reading-room]');
    if (!root) return;
    const controller = new AbortController();
    editionWindow.__arEditionController = controller;
    const items = [...root.querySelectorAll<HTMLElement>('[data-reading-item]')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-reading-filter]')];
    const more = root.querySelector<HTMLButtonElement>('[data-reading-more]');
    const count = root.querySelector<HTMLElement>('[data-reading-count]');
    let kind = 'all';
    let expanded = false;
    const update = (updateUrl = false) => {
      const matches = items.filter(item => kind === 'all' || item.dataset.kind === kind);
      const shown = expanded ? matches : matches.slice(0, 4);
      items.forEach(item => { item.hidden = !shown.includes(item); });
      filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter.dataset.readingFilter === kind)));
      if (count) count.textContent = `显示 ${shown.length} / ${matches.length} 篇`;
      if (more) { more.hidden = matches.length <= 4; more.textContent = expanded ? '收起文章' : `展开其余 ${matches.length - 4} 篇`; more.setAttribute('aria-expanded', String(expanded)); }
      if (updateUrl) {
        const url = new URL(location.href);
        if (kind === 'all') url.searchParams.delete('reading');
        else url.searchParams.set('reading', kind);
        if (expanded && matches.length > 4) url.searchParams.set('reading-expanded', '1');
        else url.searchParams.delete('reading-expanded');
        history.replaceState(history.state, '', url);
      }
    };
    const restore = () => {
      const params = new URL(location.href).searchParams;
      const requested = params.get('reading') ?? 'all';
      kind = filters.some(filter => filter.dataset.readingFilter === requested) ? requested : 'all';
      expanded = params.get('reading-expanded') === '1';
      update();
    };
    filters.forEach(filter => filter.addEventListener('click', () => { kind = filter.dataset.readingFilter ?? 'all'; expanded = false; update(true); }, { signal: controller.signal }));
    more?.addEventListener('click', () => { expanded = !expanded; update(true); if (!expanded) root.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' }); }, { signal: controller.signal });
    window.addEventListener('popstate', restore, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal: controller.signal });
    restore();
  }
  document.addEventListener('astro:page-load', setupReadingRoom);
  setupReadingRoom();
</script>
