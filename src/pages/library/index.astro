---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleRow from '../../components/ArticleRow.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writtenPages = posts.filter(post => ['文学批评', '装帧与排版', '东方Project'].includes(post.data.category));
const shelves = [
  {
    no: 'SHELF 01',
    title: '视觉小说与叙事',
    desc: '关于记忆、选择、界面与元叙事的阅读记录。',
    href: `/tags/${encodeURIComponent('视觉小说')}/`,
    count: posts.filter(post => post.data.tags.includes('视觉小说') || post.data.category === '文学批评').length,
    tags: '记忆 · 界面 · 元游戏',
  },
  {
    no: 'SHELF 02',
    title: '《东方紫雨幽蝶》全文',
    desc: '按章节阅读 coolcate 的长篇小说，并从目录进入间奏、原作者感言与整理校订记。',
    href: '/library/ziyudie/',
    count: posts.filter(post => post.data.category === '东方Project' || post.data.title.includes('东方')).length,
    tags: '88 章 · 间奏 · 后记',
  },
  {
    no: 'SHELF 03',
    title: '装帧与校订',
    desc: 'LaTeX 版式实验、文本整理、字形选择与阅读节奏。',
    href: `/tags/${encodeURIComponent('装帧与排版')}/`,
    count: posts.filter(post => post.data.category === '装帧与排版').length,
    tags: 'LaTeX · Typography · Editorial',
  },
  {
    no: 'SHELF 04',
    title: '研究与写作方法',
    desc: '把写作、研究、计算与个人知识管理放在同一张工作台上。',
    href: `/tags/${encodeURIComponent('方法')}/`,
    count: posts.filter(post => post.data.tags.includes('方法')).length,
    tags: 'Workflow · Tools · Research',
  },
];
---

<BaseLayout title="书架" description="阅读记录、作品索引、装帧与校订实践。">
  <header class="page-hero">
    <div class="page-hero-grid">
      <div><p class="eyebrow">LIBRARY / 书架</p><h1>读过的书<br />与<em>留下的页</em></h1></div>
      <p class="page-hero-description">这张书架沿着文本之间的关系展开，收纳阅读记录、作品索引、装帧试验和校订手记。</p>
    </div>
  </header>
  <section class="page-content">
    <aside class="library-preface">
      <p class="eyebrow">A NOTE FROM THE DESK</p>
      <p>这里不按读完的数量计数。尚未形成公开笔记的阅读先留在纸面；遇到值得继续追问的问题，再把它编进索引。</p>
    </aside>

    <a class="library-light-note" href="/light-notes/" data-reveal>
      <figure>
        <img src="/images/journal/2026-summer/20260716-191447-thumb.webp" width="720" height="540" loading="lazy" decoding="async" alt="西湖晚霞映在水面，同行小偶在近处看向镜头" />
      </figure>
      <div>
        <p class="eyebrow">LIGHT NOTES / 光影札记</p>
        <span>2026.07 · 43 FRAMES</span>
        <h2>书页之外，<br />还有一路经过的<em>光</em></h2>
        <p>校园、湖岸、夜航与途中饭桌。先把时间和地点认真存下，故事会在往后的整理中慢慢长出来。</p>
        <strong>走进七月的旅途档案 <b aria-hidden="true">↗</b></strong>
      </div>
    </a>

    <section class="library-written" aria-labelledby="written-pages-title">
      <div class="library-section-heading">
        <div><p class="eyebrow">WRITTEN PAGES / 已写下</p><h2 id="written-pages-title">已经进入档案的书页</h2></div>
        <span>{String(writtenPages.length).padStart(2, '0')} ENTRIES</span>
      </div>
      {writtenPages.map((post, index) => <ArticleRow post={post} number={String(index + 1).padStart(2, '0')} />)}
    </section>

    <div class="page-controls library-map-heading"><span class="page-count">按主题慢慢归档</span><span class="eyebrow">A READING MAP</span></div>
    <div class="library-grid">
      {shelves.map(shelf => (
        <a class="library-entry" href={shelf.href}>
          <p class="eyebrow">{shelf.no}</p>
          <span class="library-count">{shelf.count > 0 ? `${String(shelf.count).padStart(2, '0')} 页` : '等待整理'}</span>
          <h2>{shelf.title}</h2>
          <p>{shelf.desc}</p>
          <footer><span>{shelf.tags}</span><b aria-hidden="true">↗</b></footer>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .library-light-note {
    margin: clamp(54px, 8vw, 96px) 0;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, .8fr);
    min-height: 470px;
    background: var(--night);
    color: #f3efe7;
    overflow: hidden;
  }
  .library-light-note figure { margin: 0; min-height: 100%; overflow: hidden; }
  .library-light-note img { width: 100%; height: 100%; object-fit: cover; transition: transform .9s cubic-bezier(.2,.7,.2,1); }
  .library-light-note > div { padding: clamp(38px, 5vw, 70px); display: flex; flex-direction: column; justify-content: center; }
  .library-light-note .eyebrow { color: #c7d1d6; }
  .library-light-note > div > span { margin-top: 14px; color: #b7c0c6; font: 300 9px/1.4 var(--mono); letter-spacing: .14em; }
  .library-light-note h2 { margin: 30px 0 18px; font-size: clamp(30px, 3.3vw, 48px); line-height: 1.25; font-weight: 500; }
  .library-light-note h2 em { color: #e8b870; font-style: normal; }
  .library-light-note > div > p:not(.eyebrow) { margin: 0; color: #c8c7c2; font-size: 14px; line-height: 1.9; }
  .library-light-note strong { width: max-content; margin-top: 36px; padding-bottom: 8px; border-bottom: 1px solid rgba(243,239,231,.5); font-size: 12px; letter-spacing: .08em; }
  .library-light-note strong b { margin-left: 18px; color: #e8b870; font-family: var(--mono); }
  .library-light-note:hover img { transform: scale(1.025); }
  @media (max-width: 760px) {
    .library-light-note { grid-template-columns: 1fr; min-height: 0; }
    .library-light-note figure { aspect-ratio: 4 / 3; }
    .library-light-note > div { padding: 34px 26px 40px; }
  }
</style>
