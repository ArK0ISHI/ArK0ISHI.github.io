---
import WorkbenchLayout from '../../../layouts/WorkbenchLayout.astro';
import MoonGate from '../../../components/MoonGate.astro';
import { Image } from 'astro:assets';
import avatar from '../../../assets/avatar.jpg';
---
<WorkbenchLayout title="月之暗面 · 完整工作台" description="四届绩点、学期轨迹、完整课程与保研分析。原版全部数据，打开即用。">
  <main class="wb" id="main" data-workbench>
    <header class="wb-toolbar">
      <a class="wb-identity" href="/" aria-label="返回亚略的主页"><Image src={avatar} width={32} height={32} alt="" /></a>
      <h1>月之暗面 <span>数据工作台</span></h1>
      <nav class="wb-tools" aria-label="工作台操作">
        <a href="/" class="wb-home">主页 <span aria-hidden="true">↗</span></a>
        <button type="button" data-wb-expand hidden>全屏</button>
        <details class="wb-more" data-wb-tools hidden>
          <summary aria-label="更多工作台操作">更多 <span aria-hidden="true">⌄</span></summary>
          <div class="wb-menu">
            <span class="wb-menu-label">工作台</span>
            <button type="button" data-wb-reload>重置筛选与视图</button>
            <a href="/moon/" class="wb-back">月面概览 <span aria-hidden="true">↗</span></a>
            <button type="button" data-moon-relock>重新隐藏入口</button>
          </div>
        </details>
      </nav>
    </header>
    <section class="wb-locked" data-wb-locked aria-labelledby="wb-locked-title">
      <div><p class="wb-eyebrow">THE FAR SIDE</p><h2 id="wb-locked-title">月亮的另一侧，<br />藏着一张星图。</h2><p>从这枚月亮，重新找到入口。</p>
      <noscript><p>请启用 JavaScript，以便展开数据和绘制图表。</p></noscript></div>
    </section>
    <MoonGate />
    <div class="wb-content" data-wb-content hidden>
      <p class="wb-sr-only" data-wb-status role="status" aria-live="polite">完整工作台，即将展开。</p>
      <p class="wb-sr-only" data-wb-summary></p>
      <section class="wb-error" data-wb-error hidden role="alert"><p>完整工作台暂时未能载入。</p><button type="button" data-wb-retry>重新载入 ↻</button></section>
      <section class="wb-room" data-wb-room hidden aria-label="完整数据工作台">
        <div class="wb-loading" data-wb-loading><span class="wb-loading-orbit" aria-hidden="true">◌</span><p>正在展开整张星图</p><small>首次进入需要载入完整数据，请稍候。</small></div>
        <iframe data-wb-frame title="月之暗面：完整原版的十一个分析模块" sandbox="allow-scripts allow-downloads allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer"></iframe>
      </section>
    </div>
  </main>
  <script>import '../../../scripts/moon-workbench';</script>
</WorkbenchLayout>
